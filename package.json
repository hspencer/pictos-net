{
  "name": "pictos.net",
  "private": true,
  "version": "2.6.2",
  "type": "module",
  "scripts": {
    "dev": "npm run copy-schemas && npm run optimize-thumbs && netlify dev",
    "build": "npm run copy-schemas && npm run optimize-thumbs && vite build",
    "preview": "npm run copy-schemas && vite preview",
    "test": "node --test \"netlify/functions/**/*.test.mjs\" \"services/**/*.test.ts\"",
    "generate-index": "node scripts/generate-libraries-index.cjs",
    "validate-i18n": "node scripts/validateTranslations.cjs",
    "typecheck": "tsc --noEmit",
    "copy-schemas": "sh scripts/copy-submodule-data.sh",
    "optimize-thumbs": "node scripts/optimize-thumbs.mjs",
    "postinstall": "npm run copy-schemas",
    "test:schemas": "npm test --prefix schemas/nlu-schema && npm test --prefix schemas/pictogram-composition-schema && npm test --prefix schemas/mf-svg-schema && npm run check:sync --prefix schemas/mf-svg-schema"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@netlify/blobs": "^10.7.9",
    "@xmldom/xmldom": "0.9.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "google-auth-library": "^10.7.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "martinez-polygon-clipping": "^0.8.1",
    "netlify-identity-widget": "^2.0.3",
    "paper": "^0.12.18",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
