-- allium: 3
-- element-tree.allium

-- Disambiguation: this spec governs the COMPONER-phase VisualElement hierarchy
--   (the compositional tree a user arranges before image generation). It is
--   NOT the SVG editor's SemanticTree / element-tree panel, which lists the
--   live SVG DOM of a document being edited. Same name, different concern; the
--   SVG editor's tree panel is specified in vector-editor.allium.

-- Scope: Hierarchical element tree editor for the COMPONER phase
-- Includes: Tree structure, drag-and-drop reordering, visual connections, invalidation
-- Excludes:
--   - Prompt generation logic (handled by geminiService)
--   - Bitmap generation (downstream phase)
--   - Element naming validation rules
-- Dependencies: VisualElement type from types.ts

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- The spatial articulation prompt managed by the COMPONER phase. This spec
-- only signals when it becomes outdated.
external entity SpatialPrompt {
    status: idle | outdated
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum DropZone {
    before      -- insert as previous sibling of target
    | inside    -- insert as last child of target
    | after     -- insert as next sibling of target
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity ElementTree {
    root: Element
    prompt: SpatialPrompt
    status: idle | dragging
    dragged: Element?
    target: Element?
    zone: DropZone?

    transitions status {
        idle -> dragging
        dragging -> idle
    }
}

entity Element {
    id: String
    tree: ElementTree
    parent: Element?
    children: Element with parent = this

    is_root: parent = null
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    max_depth: Integer = 5          -- root = level 1
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- === Drag initiation ===

rule DragStart {
    when: ElementGrabbed(tree, element)
    requires: tree.status = idle
    requires: not element.is_root
    ensures: tree.status = dragging
    ensures: tree.dragged = element

    @guidance
        -- The dragged element and its subtree are shown at reduced opacity;
        -- the cursor changes to grabbing.
}

-- === Drop zone detection ===

rule DropZoneDetect {
    when: ElementDraggedOver(tree, target, zone)
    requires: tree.status = dragging
    requires: target != tree.dragged
    requires: not is_descendant(target, tree.dragged)
    ensures: tree.target = target
    ensures: tree.zone = zone

    @guidance
        -- The zone follows the cursor's vertical position over the target:
        -- top third = before, middle third = inside, bottom third = after.
        -- Indicators: a line above (before), a highlighted node (inside), a
        -- line below (after).
}

-- === Drop execution ===

rule DropReorder {
    when: ElementDropped(tree)
    requires: tree.status = dragging
    requires: tree.target != null
    requires: tree.zone != null
    requires: not is_descendant(tree.target, tree.dragged)
    requires: tree.zone != inside
        or depth(tree.target) + subtree_depth(tree.dragged) <= config.max_depth
    ensures: move_subtree(tree.dragged, tree.target, tree.zone)
    ensures: tree.status = idle
    ensures: tree.dragged = null
    ensures: tree.target = null
    ensures: tree.zone = null
    ensures: tree.prompt.status = outdated

    @guidance
        -- before: the dragged element becomes the previous sibling of the
        -- target; inside: its last child; after: its next sibling. The
        -- dragged element's subtree moves with it intact.
}

rule DropCancel {
    when: DragCancelled(tree)
    requires: tree.status = dragging
    ensures: tree.status = idle
    ensures: tree.dragged = null
    ensures: tree.target = null
    ensures: tree.zone = null

    @guidance
        -- Releasing outside a valid zone or pressing Escape leaves the tree
        -- unchanged.
}

-- === Tree mutations that invalidate the prompt ===

rule AddElement {
    when: ElementAdded(tree, parent, id)
    requires: depth(parent) < config.max_depth
    requires: trim(id) != ""
    requires: not tree_contains_id(tree, id)
    ensures: Element.created(id: id, tree: tree, parent: parent)
    ensures: tree.prompt.status = outdated

    @guidance
        -- The new element becomes the last child of its parent.
}

rule RemoveElement {
    when: ElementRemoved(tree, element)
    requires: not element.is_root
    ensures: not exists element
    ensures: tree.prompt.status = outdated

    @guidance
        -- The element's subtree is removed with it.
}

rule RenameElement {
    when: ElementRenamed(tree, element, id)
    requires: trim(id) != ""
    requires: not tree_contains_id(tree, id)
    ensures: element.id = id
    ensures: tree.prompt.status = outdated
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant SingleRoot {
    for tree in ElementTrees:
        tree.root.is_root
        and tree.root.id in {"pictograma", "pictogram"}
}

invariant NoCycles {
    for element in Elements:
        not is_descendant(element, element)
}

invariant MaxDepth {
    for element in Elements:
        depth(element) <= config.max_depth
}

invariant UniqueIds {
    for a in Elements:
        for b in Elements:
            a != b and a.tree = b.tree implies a.id != b.id
}

invariant RootIsNeverDragged {
    for tree in ElementTrees:
        tree.dragged != null implies not tree.dragged.is_root
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface ElementTreeView {
    facing editor: ElementTree

    exposes:
        editor.root
        editor.status
        editor.dragged
        editor.target
        editor.zone
        editor.prompt.status

    provides:
        ElementGrabbed(editor, element)
        ElementDraggedOver(editor, target, zone)
        ElementDropped(editor)
        DragCancelled(editor)
        ElementAdded(editor, parent, id)
        ElementRemoved(editor, element)
        ElementRenamed(editor, element, id)

    @guarantee RootIsFixed
        -- The root is the composition's deterministic root ('pictograma' for
        -- Spanish, 'pictogram' otherwise). It cannot be moved, removed or
        -- preceded or followed by a sibling. Dropping inside the root uses
        -- the cursor: upper half makes the dragged element the first child,
        -- lower half the last child.

    @guarantee InvalidDropsChangeNothing
        -- Dropping an element on itself or on one of its descendants is
        -- rejected without any change and without a drop indicator.

    @guidance
        -- Drawn connections: parent-child lines are drawn (SVG or CSS), not
        -- typographic characters; a vertical line from the parent and a
        -- horizontal line to each child, with an L-shaped connector on the
        -- last child. Each non-root element shows a drag handle on hover, to
        -- the left of its pill; dragging the pill also starts a drag. While
        -- the prompt is outdated its panel has a pale yellow background
        -- (amber-50). The "regenerate spatial prompt" button appears below
        -- the tree only after the tree was edited (add, remove, rename,
        -- reorder), never on a pristine tree or after editing the prompt
        -- text alone, stays until a regeneration completes, is sized to its
        -- content and aligned right, and runs the regeneration described in
        -- visual-reasoning.allium. While dragging a parent, its subtree moves
        -- with it at reduced opacity.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- Resolved: pointer/mouse only, no touch support for now
-- Resolved: max tree depth is 5 (root = level 1)
-- Resolved: drop inside root uses cursor position (upper half = first child, lower half = last child)
