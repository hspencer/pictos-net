-- allium: 3
-- generation-config.allium

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity GlobalConfig {
    generation_model: GenerationModel
    openai_image_quality: OpenAIImageQuality?
    phase5_model: Phase5StructuringModel?
    recraft_style_id: String?
    legacy_image_model: String?
    advanced_config_expanded: Boolean
}

external entity VisualReasoning {
    generation_model: GenerationModel?
    generation_quality: OpenAIImageQuality?
    bitmap_present: Boolean
    nlu_status: PipelineStatus
    visual_status: PipelineStatus
    bitmap_status: PipelineStatus
}

external entity Phase3Attempt {
    reasoning: VisualReasoning
    selected_model: GenerationModel
    selected_quality: OpenAIImageQuality?
    family: ModelFamily
    status: AttemptStatus
    recoverable: Boolean
    generation_unit_refunded: Boolean
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract ModelCatalogBoundary {
    options: (phase: CatalogPhase) -> List<Any>
    validate_selection: (phase: CatalogPhase, model: String) -> Boolean

    @invariant OneCapabilityCatalog
        -- User options and server admission use the same model identifiers,
        -- providers and phase capabilities. A text or vision model is not an
        -- image-generation model merely because it accepts images. OpenAI
        -- GPT-5.6 Luna, Terra and Sol are selectable for Phases 1, 2 and 5,
        -- including the explicit Phase 5 redraw/vision route.

    @invariant SelectionIsProspectiveAndExplicit
        -- Preserve existing defaults and saved selections. Adding a candidate
        -- does not replace a user's model or regenerate existing artifacts.
        -- Validate model and phase before any provider call. Unsupported
        -- combinations fail explicitly, without provider/model substitution.
        -- Every new OpenAI text call uses the configured explicit low reasoning
        -- effort; it does not inherit an undocumented provider default.

    @invariant PricesAreDatedConditionalEstimates
        -- Display currency, token/image unit, input/output distinction, source
        -- date and applicable context/quality conditions with catalog prices.
        -- OpenAI standard text rates here apply only within the documented
        -- short-context tier; longer requests cannot use that price silently.
        -- PictoNet quota units are not dollars: zero internal text units does
        -- not mean free provider usage. Price and capability are not benchmark
        -- evidence of semantic quality, availability or account authorization.

    @invariant RecraftCapabilitiesAreExplicit
        -- Recraft V4.1 includes standard, Pro, Utility and Utility Pro, each in
        -- raster and vector form. V4 Styles includes standard and Pro in raster
        -- and vector form. The catalog distinguishes square 1K raster, square
        -- 2K Pro raster and native square vectors; model names never substitute
        -- for checking the actual returned artifact type.

    @invariant RecraftStyleAdmission
        -- V4 Styles requires an explicitly supplied nonempty valid style id
        -- before charging or contacting the provider. Other V4.1 models may
        -- use one optionally. No automatic paid style creation, reference
        -- upload or silent style/model replacement accompanies selection.
        -- Recraft prompts exceeding config.recraft_prompt_max_characters fail
        -- locally rather than being silently truncated or rewritten.
}

contract GenerationConfigurationBoundary {
    select_generation_model: (config: GlobalConfig, model: GenerationModel) -> ModelChangeRequest
    select_openai_quality: (config: GlobalConfig, quality: OpenAIImageQuality) -> GlobalConfig
    select_phase5_model: (config: GlobalConfig, model: Phase5StructuringModel) -> GlobalConfig
    resolve_model_family: (model: GenerationModel) -> ModelFamily

    @invariant SquareOutput
        -- Every Phase 3 model produces a square artifact. Gemini uses 1:1 and
        -- OpenAI and Recraft use their square equivalent; aspect ratio is not configurable.

    @invariant OpenAIQualityIsProspective
        -- OpenAI offers low, medium, and high quality, with low as the default
        -- when absent. Changing quality affects future calls only and never
        -- automatically regenerates existing artifacts or changes other models.

    @invariant WarningBeforeAffectingExistingRows
        -- A model change affecting existing rows is not committed until the
        -- user chooses change-only, bulk regeneration, or cancel.

    @invariant Phase5ChangeIsProspective
        -- Changing the Phase 5 model does not mutate completed structured SVGs.

    @invariant LibraryConfigurationPanelsAreExclusive
        -- Basic settings and advanced model settings form one accordion in
        -- the library configuration interface. Expanding either closes the
        -- other; activating the expanded section closes it, allowing both
        -- sections to remain collapsed. They are never expanded together.

    @invariant AccordionVisibilityPreservesConfiguration
        -- Expanding or collapsing either section changes visibility only.
        -- It never resets edited settings, model selections or other stored
        -- configuration, and never regenerates, discards or changes existing
        -- generation artifacts or their statuses.

    @invariant NoSilentProviderFallback
        -- A terminal provider-quota failure remains attributed to the selected
        -- model; no alternate Gemini, OpenAI, or Recraft model is invoked.
}

contract BulkRegenerationBoundary {
    request_bulk_regeneration: (request: ModelChangeRequest) -> BulkRegeneration

    @invariant UpstreamArtifactsPreserved
        -- Bulk regeneration re-runs Phase 3 only. Completed Phase 1 and Phase 2
        -- artifacts and statuses remain unchanged.

    @invariant CoherentPhase3Inputs
        -- Each affected row snapshots its current utterance, NLU, elements, and
        -- prompt atomically when the Phase 3 retry begins.

    @invariant PictoNetQuotaSkipsAreExplicit
        -- If PictoNet user quota cannot admit every affected row, admitted rows
        -- run and skipped rows retain their prior artifact and provenance.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum GenerationModel {
    `gemini-2.5-flash-image` |
    `gemini-3.1-flash-image` |
    `gemini-3-pro-image` |
    `gpt-image-2` |
    recraftv4_1 |
    recraftv4_1_vector |
    recraftv4_1_pro |
    recraftv4_1_pro_vector |
    recraftv4_1_utility |
    recraftv4_1_utility_vector |
    recraftv4_1_utility_pro |
    recraftv4_1_utility_pro_vector |
    recraftv4_styles |
    recraftv4_styles_vector |
    recraftv4_styles_pro |
    recraftv4_styles_pro_vector
}

enum Phase5StructuringModel {
    `claude-sonnet-4-6` |
    `claude-opus-4-6` |
    `gemini-2.5-pro` |
    `gemini-2.5-flash` |
    `gpt-5.6-luna` |
    `gpt-5.6-terra` |
    `gpt-5.6-sol`
}

enum CatalogPhase { phase1 | phase2 | phase3 | phase5 }
enum ModelFamily { bitmap | vector }
enum OpenAIImageQuality { low | medium | high }
enum PipelineStatus { idle | processing | completed | error | outdated }
enum AttemptStatus { processing | completed | error }
enum ModelChangeDecision { change_only | change_and_regenerate | cancel }
enum ModelChangeState { awaiting_decision | accepted | cancelled }
enum BulkRegenerationState { pending | running | completed | partial }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity ModelChangeRequest {
    config: GlobalConfig
    current_model: GenerationModel
    requested_model: GenerationModel
    affected_count: Integer
    decision: ModelChangeDecision?
    state: ModelChangeState
}

entity BulkRegeneration {
    request: ModelChangeRequest
    requested_count: Integer
    admitted_count: Integer
    skipped_count: Integer
    state: BulkRegenerationState
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    recraft_prompt_max_characters: Integer = 10000
    openai_text_reasoning_effort: String = "low"
    openai_standard_context_limit: Integer = 272000
    default_generation_model: GenerationModel = `gemini-2.5-flash-image`
    default_openai_image_quality: OpenAIImageQuality = low
    default_phase5_model: Phase5StructuringModel = `gemini-2.5-flash`
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule InitialiseGenerationConfig {
    when: GenerationConfigInitialised(global_config)
    ensures: global_config.generation_model = config.default_generation_model
    ensures: global_config.openai_image_quality = config.default_openai_image_quality
    ensures: global_config.phase5_model = config.default_phase5_model
    ensures: global_config.advanced_config_expanded = false
}

rule ChangeOpenAIImageQuality {
    when: OpenAIImageQualitySelected(global_config, selected_quality)
    ensures: global_config.openai_image_quality = selected_quality
}

rule MigrateLegacyGeminiFlash {
    when: LegacyImageModelDetected(global_config, legacy_value)
    requires: legacy_value in {"flash", "gemini-2.0-flash-exp"}
    ensures: global_config.generation_model = `gemini-2.5-flash-image`
    ensures: global_config.legacy_image_model = null
}

rule MigrateLegacyGeminiPro {
    when: LegacyImageModelDetected(global_config, legacy_value)
    requires: legacy_value = "pro"
    ensures: global_config.generation_model = `gemini-3-pro-image`
    ensures: global_config.legacy_image_model = null
}

rule MigrateLegacyRecraftRaster {
    when: LegacyImageModelDetected(global_config, legacy_value)
    requires: legacy_value = "recraftv4_1"
    ensures: global_config.generation_model = recraftv4_1
    ensures: global_config.legacy_image_model = null
}

rule MigrateLegacyRecraftVector {
    when: LegacyImageModelDetected(global_config, legacy_value)
    requires: legacy_value = "recraftv4_1_vector"
    ensures: global_config.generation_model = recraftv4_1_vector
    ensures: global_config.legacy_image_model = null
}

rule MigrateUnknownLegacyModel {
    when: LegacyImageModelDetected(global_config, legacy_value)
    requires: legacy_value not in {
        "flash",
        "gemini-2.0-flash-exp",
        "pro",
        "recraftv4_1",
        "recraftv4_1_vector"
    }
    ensures: global_config.generation_model = config.default_generation_model
    ensures: global_config.legacy_image_model = null
}

rule RequestAffectingModelChange {
    when: AffectingGenerationModelChangeRequested(global_config, selected_model, affected_count)
    requires: affected_count > 0
    ensures: ModelChangeRequest.created(
        config: global_config,
        current_model: global_config.generation_model,
        requested_model: selected_model,
        affected_count: affected_count,
        decision: null,
        state: awaiting_decision
    )
}

rule ChangeModelWithoutAffectedRows {
    when: UnaffectingGenerationModelChangeRequested(global_config, selected_model)
    ensures: global_config.generation_model = selected_model
}

rule CancelModelChange {
    when: ModelChangeDecided(request, cancel)
    requires: request.state = awaiting_decision
    ensures: request.decision = cancel
    ensures: request.state = cancelled
}

rule AcceptModelChangeOnly {
    when: ModelChangeDecided(request, change_only)
    requires: request.state = awaiting_decision
    ensures: request.decision = change_only
    ensures: request.config.generation_model = request.requested_model
    ensures: request.state = accepted
}

rule AcceptModelChangeAndRegenerate {
    when: ModelChangeDecided(request, change_and_regenerate)
    requires: request.state = awaiting_decision
    ensures: request.decision = change_and_regenerate
    ensures: request.config.generation_model = request.requested_model
    ensures: request.state = accepted
    ensures: BulkRegeneration.created(
        request: request,
        requested_count: request.affected_count,
        admitted_count: 0,
        skipped_count: 0,
        state: pending
    )
}

rule StartBulkRegeneration {
    when: BulkRegenerationAdmitted(regeneration, admitted_count)
    requires: regeneration.state = pending
    requires: admitted_count >= 0
    requires: admitted_count <= regeneration.requested_count
    ensures: regeneration.admitted_count = admitted_count
    ensures: regeneration.skipped_count = regeneration.requested_count - admitted_count
    ensures: regeneration.state = running
}

rule CompleteBulkRegeneration {
    when: BulkRegenerationFinished(regeneration)
    requires: regeneration.state = running
    ensures:
        if regeneration.skipped_count = 0:
            regeneration.state = completed
        else:
            regeneration.state = partial
}

rule ChangePhase5Model {
    when: Phase5ModelChangeRequested(global_config, selected_model)
    ensures: global_config.phase5_model = selected_model
}

rule RecordPhase3Provenance {
    when: attempt: Phase3Attempt.status transitions_to completed
    ensures: attempt.reasoning.generation_model = attempt.selected_model
    ensures: attempt.reasoning.generation_quality = attempt.selected_quality
}

rule ImageProviderQuotaIsRecoverable {
    when: ImageProviderQuotaExhausted(attempt)
    requires: attempt.status = processing
    requires: attempt.selected_model in {
        `gemini-2.5-flash-image`,
        `gemini-3.1-flash-image`,
        `gemini-3-pro-image`,
        `gpt-image-2`
    }
    ensures: attempt.status = error
    ensures: attempt.recoverable = true
    ensures: attempt.generation_unit_refunded = true
    ensures: attempt.reasoning.bitmap_status = error

    @guidance
        -- Report this as the selected external provider's quota, distinct from the
        -- user's PictoNet daily quota. Keep the selected model unchanged and
        -- expose an explicit Phase 3 retry or user-selected model change.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant BulkCountsPartitionRequest {
    for regeneration in BulkRegenerations:
        regeneration.admitted_count + regeneration.skipped_count =
            regeneration.requested_count
}

invariant VTraceVisibilityByArtifact {
    for reasoning in VisualReasonings:
        reasoning.bitmap_present implies not generation_model_is_vector(reasoning.generation_model)
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface GenerationConfiguration {
    contracts:
        fulfils ModelCatalogBoundary
        fulfils GenerationConfigurationBoundary
        fulfils BulkRegenerationBoundary

    @guarantee AdvancedControlsAreBounded
        -- Advanced configuration contains generation model, Phase 5 model,
        -- domain context, colour palette, SVG style definitions, and keyframes.
        -- Selecting GPT Image 2 reveals its low/medium/high quality control.
        -- GPT Image 2 belongs to the bitmap family and keeps VTrace available.
        -- Existing persisted model selections are preserved; only fresh config
        -- receives the Gemini default. Missing OpenAI quality resolves to low.
        -- Aspect ratio and the legacy image-model field are never exposed.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "When bulk regeneration is interrupted by reload, should unfinished admitted rows resume automatically?"
open question "Should PictoNet-quota-skipped bulk rows retain a persistent indicator until manually regenerated?"
