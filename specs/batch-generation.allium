-- allium: 3
-- batch-generation.allium

use "./generation-config.allium" as generation
use "./usage-enforcement.allium" as usage
use "./visual-reasoning.allium" as visual

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity Library {
    id: String
}

external entity Row {
    id: String
    utterance: String
    nlu: visual/NLUData?
    elements: List<visual/VisualElement>?
    prompt: String?
    bitmap: String?
    raw_svg: String?
    nlu_status: visual/StepStatus
    visual_status: visual/StepStatus
    bitmap_status: visual/StepStatus
    generation_model: generation/GenerationModel?
    generation_quality: generation/OpenAIImageQuality?
}

external entity Sequence {
    id: String
    name: String
    reference_row: Row?
}

external entity LibraryConfig {
    library: Library
    reference_row: Row?
}

external entity GlobalConfig {
    comprender_model: visual/NLUModel?
    componer_model: visual/NLUModel?
    generation_model: generation/GenerationModel
    openai_image_quality: generation/OpenAIImageQuality?
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value BatchItem {
    row_id: String
    prompt_hash: String
}

value BatchOutcome {
    row_id: String
    succeeded: Boolean
    bitmap: String?
    error_message: String?
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract VertexBatchBoundary {
    submit: (job: BatchJob) -> String
    poll: (job: BatchJob) -> VertexState
    collect: (job: BatchJob) -> List<BatchOutcome>

    @invariant GeminiImageOnly
        -- Vertex batch accepts Gemini 2.5 Flash Image and Gemini 3.1 Flash
        -- Image only. OpenAI, Recraft, and Gemini 3 Pro are excluded. When
        -- OpenAI is selected, the deferred Vertex action is unavailable and
        -- direct submission is rejected; no Gemini replacement is selected.

    @invariant ContentBasedCorrelation
        -- Each exact composed prompt is hashed in the manifest because Vertex
        -- output echoes requests but provides no custom row identifier.

    @invariant IncrementalCollection
        -- Completed output lines may be collected while the Vertex job is still
        -- running, so individual pictograms become available early.

    @invariant CrossSessionResumption
        -- Server-side job state is authoritative. Reopening the library resumes
        -- polling and collection without depending on browser-only state.

    @invariant PartialVertexOutputIsCollected
        -- Failed, cancelled, and expired Vertex jobs still collect exported
        -- successful lines; rows with no output receive an explicit error.

    @invariant QuotaReservedOnceAtSubmission
        -- One generation unit per submitted row is reserved before creation.
        -- Polling and collection never charge again; a job that never starts is
        -- refunded through usage enforcement.

    @invariant TemporaryArtifactsAreCleaned
        -- Input JSONL, output prefixes, and reference copies are removed after
        -- collection on a best-effort basis with storage lifecycle as fallback.
}

contract ReferencePictogramBoundary {
    resolve_reference: (sequence: Sequence, library_config: LibraryConfig) -> Row

    @invariant SequenceReferencePrecedesLibraryReference
        -- A sequence reference overrides the library reference. Missing or
        -- unusable references fall back to textual anchors without deadlock.

    @invariant JobOwnsReferenceCopy
        -- Each submitted job stores its own immutable reference copy. Later
        -- deletion, regeneration, or re-selection cannot alter an active job.

    @invariant CompletedPictogramsOnly
        -- Only a row with completed Phase 3 output may become a reference.

    @invariant SequenceAnchorsArePhase3Only
        -- Sequence submission derives one shared character, palette, objects,
        -- setting, and step-position preamble without changing Phase 1 meaning.
}

contract PipelineBatchBoundary {
    run_full_pipeline: (job: PipelineBatchJob) -> PipelineBatchState

    @invariant SequentialRows
        -- Rows run in position order so a provider-quota circuit can stop before
        -- any provider call is attempted for remaining rows.

    @invariant CoherentPhase3Snapshot
        -- Phase 3 consumes one atomic snapshot of the current row utterance,
        -- returned NLU, returned elements, and returned prompt.
        -- GPT Image 2 uses the same complete textual composition as individual
        -- generation. The submitted model and effective quality are frozen
        -- for the job and persisted with every successful result.

    @invariant ProviderQuotaCircuitBreaker
        -- The first terminal provider 429 in Phase 1, 2 or 3, including Recraft
        -- and non-retryable billing exhaustion, marks the actual failing phase
        -- as error, preserves already accepted phases and their provenance,
        -- defers every unattempted later row,
        -- records provider-quota blocking on the job, and makes no further
        -- Phase 1, Phase 2, or Phase 3 provider call for that job.

    @invariant NoSilentFallback
        -- The circuit never invokes another Gemini, OpenAI, or Recraft model automatically.

    @invariant ScopedExactlyOnceRefund
        -- The current row's precharged generation unit and all deferred rows
        -- are refunded once, even if text failed before image generation. Rows
        -- completed before the circuit remain charged. Other failed OpenAI or
        -- Recraft Phase 3 rows are refunded individually; their row keys must
        -- neither duplicate nor suppress a later circuit refund.

    @invariant SuccessfulApplicationCompletesUpstreamStatuses
        -- Applying a completed result writes NLU, elements, prompt, and image to
        -- the library row and marks Phase 1, Phase 2, and Phase 3 completed.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum VertexState { pending | running | succeeded | failed | cancelled | expired }
enum BatchState { submitted | queued | running | collecting | completed | failed }
enum PipelineBatchState { running | completed | failed | provider_quota_blocked }
enum PipelineBatchRowState { pending | processing | completed | error | provider_error | deferred }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity BatchJob {
    id: String
    library: Library
    owner: usage/IdentityUser
    reservation: usage/BatchReservation
    model: generation/GenerationModel
    sequence: Sequence?
    anchors: String?
    reference_row: Row?
    reference_copy_uri: String?
    vertex_job_name: String
    last_vertex_state: VertexState
    state: BatchState
    items: List<BatchItem>
    row_count: Integer
    succeeded_count: Integer
    failed_count: Integer
    created_at: Timestamp
    collected_at: Timestamp?
}

entity PipelineBatchJob {
    id: String
    library: Library
    owner: usage/IdentityUser
    config: GlobalConfig
    selected_model: generation/GenerationModel
    selected_quality: generation/OpenAIImageQuality?
    reservation: usage/BatchReservation
    state: PipelineBatchState
    row_count: Integer
    provider_quota_blocked_at_row_id: String?
    provider_quota_phase: usage/GenerationPhase?
    provider_quota_provider: usage/Provider?
    provider_quota_failure_source: usage/QuotaFailureSource?
    refunded_generation_units: Integer
    unresolved_after_timeout: Boolean
    created_at: Timestamp

    rows: PipelineBatchRow with job = this
}

entity PipelineBatchRow {
    job: PipelineBatchJob
    source_row: Row
    position: Integer
    state: PipelineBatchRowState
    nlu: visual/NLUData?
    elements: List<visual/VisualElement>?
    prompt: String?
    bitmap: String?
    phase1_status: visual/StepStatus
    phase2_status: visual/StepStatus
    phase3_status: visual/StepStatus
    error_message: String?
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    max_rows_per_vertex_batch: Integer = 200
    max_rows_per_pipeline_batch: Integer = 25
    pipeline_timeout: Duration = 15.minutes
    poll_interval: Duration = 60.seconds
    vertex_batch_models: Set<generation/GenerationModel> = {
        `gemini-2.5-flash-image`,
        `gemini-3.1-flash-image`
    }
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule SelectSequenceReference {
    when: SequenceReferenceSelected(sequence, row)
    requires: row.bitmap_status = completed
    requires: row.bitmap != null or row.raw_svg != null
    ensures: sequence.reference_row = row
}

rule SelectLibraryReference {
    when: LibraryReferenceSelected(library_config, row)
    requires: row.bitmap_status = completed
    requires: row.bitmap != null or row.raw_svg != null
    ensures: library_config.reference_row = row
}

rule ClearRemovedSequenceReference {
    when: ReferencedRowRemoved(sequence, row)
    requires: sequence.reference_row = row
    ensures: sequence.reference_row = null
}

rule ClearRemovedLibraryReference {
    when: ReferencedLibraryRowRemoved(library_config, row)
    requires: library_config.reference_row = row
    ensures: library_config.reference_row = null
}

rule SubmitVertexBatch {
    when: VertexBatchSubmitted(
        library,
        owner,
        reservation,
        rows,
        model,
        manifest,
        vertex_job_name,
        reference_row,
        reference_copy_uri
    )
    requires: model in config.vertex_batch_models
    requires: rows.count >= 1
    requires: rows.count <= config.max_rows_per_vertex_batch
    requires: rows.all(r => r.prompt != null)
    requires: manifest.count = rows.count
    requires: reservation.reserved_units = rows.count
    ensures: BatchJob.created(
        id: vertex_job_name,
        library: library,
        owner: owner,
        reservation: reservation,
        model: model,
        sequence: null,
        anchors: null,
        reference_row: reference_row,
        reference_copy_uri: reference_copy_uri,
        vertex_job_name: vertex_job_name,
        last_vertex_state: pending,
        state: submitted,
        items: manifest,
        row_count: rows.count,
        succeeded_count: 0,
        failed_count: 0,
        created_at: now,
        collected_at: null
    )
    ensures:
        for row in rows:
            row.bitmap_status = processing
}

rule SubmitSequenceVertexBatch {
    when: SequenceVertexBatchSubmitted(
        library,
        owner,
        reservation,
        sequence,
        rows,
        model,
        anchors,
        manifest,
        vertex_job_name,
        reference_row,
        reference_copy_uri
    )
    requires: model in config.vertex_batch_models
    requires: rows.count >= 1
    requires: rows.count <= config.max_rows_per_vertex_batch
    requires: rows.all(r => r.prompt != null)
    requires: manifest.count = rows.count
    requires: reservation.reserved_units = rows.count
    requires: anchors != ""
    ensures: BatchJob.created(
        id: vertex_job_name,
        library: library,
        owner: owner,
        reservation: reservation,
        model: model,
        sequence: sequence,
        anchors: anchors,
        reference_row: reference_row,
        reference_copy_uri: reference_copy_uri,
        vertex_job_name: vertex_job_name,
        last_vertex_state: pending,
        state: submitted,
        items: manifest,
        row_count: rows.count,
        succeeded_count: 0,
        failed_count: 0,
        created_at: now,
        collected_at: null
    )
    ensures:
        for row in rows:
            row.bitmap_status = processing
}

rule QueueVertexBatch {
    when: VertexBatchQueued(job)
    requires: job.state = submitted
    ensures: job.state = queued
    ensures: job.last_vertex_state = pending
}

rule StartVertexBatch {
    when: VertexBatchStarted(job)
    requires: job.state in {submitted, queued}
    ensures: job.state = running
    ensures: job.last_vertex_state = running
}

rule RequestIncrementalCollection {
    when: VertexBatchHasNewOutput(job, succeeded_count, failed_count)
    requires: job.state = running
    requires: succeeded_count > job.succeeded_count
    ensures: job.succeeded_count = succeeded_count
    ensures: job.failed_count = failed_count
    ensures: IncrementalCollectionRequested(job)
}

rule BeginFinalCollection {
    when: VertexBatchTerminal(job, terminal_state, succeeded_count, failed_count)
    requires: job.state in {submitted, queued, running}
    requires: terminal_state in {succeeded, failed, cancelled, expired}
    ensures: job.succeeded_count = succeeded_count
    ensures: job.failed_count = failed_count
    ensures: job.last_vertex_state = terminal_state
    ensures: job.state = collecting
    ensures: FinalCollectionRequested(job)
}

rule CompleteVertexCollection {
    when: VertexCollectionSucceeded(job, outcomes)
    requires: job.state = collecting
    ensures:
        for outcome in outcomes:
            BatchOutcomeReady(outcome)
        if outcomes.any(o => o.succeeded):
            job.state = completed
            job.collected_at = now
        else:
            job.state = failed
}

rule ApplySuccessfulVertexOutcome {
    when: BatchOutcomeApplied(row, outcome)
    requires: outcome.row_id = row.id
    requires: outcome.succeeded
    requires: outcome.bitmap != null
    ensures: row.bitmap = outcome.bitmap
    ensures: row.bitmap_status = completed
}

rule ApplyFailedVertexOutcome {
    when: BatchOutcomeApplied(row, outcome)
    requires: outcome.row_id = row.id
    requires: not outcome.succeeded
    ensures: row.bitmap_status = error
}

rule SubmitPipelineBatch {
    when: PipelineBatchSubmitted(job_id, library, owner, rows, pipeline_config, reservation)
    requires: rows.count >= 1
    requires: rows.count <= config.max_rows_per_pipeline_batch
    requires: rows.all(r => r.utterance != "")
    requires: reservation.reserved_units = rows.count
    ensures:
        let job = PipelineBatchJob.created(
            id: job_id,
            library: library,
            owner: owner,
            config: pipeline_config,
            selected_model: pipeline_config.generation_model,
            selected_quality: effective_openai_quality(pipeline_config),
            reservation: reservation,
            state: running,
            row_count: rows.count,
            provider_quota_blocked_at_row_id: null,
            provider_quota_phase: null,
            provider_quota_provider: null,
            provider_quota_failure_source: null,
            refunded_generation_units: 0,
            unresolved_after_timeout: false,
            created_at: now
        )
        for row in rows:
            PipelineBatchRow.created(
                job: job,
                source_row: row,
                position: position_of(rows, row),
                state: pending,
                nlu: null,
                elements: null,
                prompt: null,
                bitmap: null,
                phase1_status: idle,
                phase2_status: idle,
                phase3_status: idle,
                error_message: null
            )
}

rule StartPipelineRow {
    when: PipelineRowStarted(row)
    requires: row.job.state = running
    requires: row.state = pending
    ensures: row.state = processing
    ensures: row.phase1_status = processing
}

rule CompletePipelinePhase1 {
    when: PipelinePhase1Succeeded(row, nlu)
    requires: row.job.state = running
    requires: row.state = processing
    requires: row.phase1_status = processing
    ensures: row.nlu = nlu
    ensures: row.phase1_status = completed
    ensures: row.phase2_status = processing
}

rule CompletePipelinePhase2 {
    when: PipelinePhase2Succeeded(row, elements, prompt)
    requires: row.job.state = running
    requires: row.state = processing
    requires: row.phase1_status = completed
    requires: row.phase2_status = processing
    requires: elements.count > 0
    requires: prompt != ""
    ensures: row.elements = elements
    ensures: row.prompt = prompt
    ensures: row.phase2_status = completed
    ensures: row.phase3_status = processing
}

rule CompletePipelinePhase3 {
    when: PipelinePhase3Succeeded(row, bitmap)
    requires: row.job.state = running
    requires: row.state = processing
    requires: row.phase1_status = completed
    requires: row.phase2_status = completed
    requires: row.phase3_status = processing
    requires: row.nlu != null
    requires: row.elements != null
    requires: row.prompt != null
    ensures: row.bitmap = bitmap
    ensures: row.phase3_status = completed
    ensures: row.state = completed
}

rule FailPipelinePhase1 {
    when: PipelinePhase1Failed(row, error_message)
    requires: row.job.state = running
    requires: row.state = processing
    requires: row.phase1_status = processing
    ensures: row.phase1_status = error
    ensures: row.state = error
    ensures: row.error_message = error_message
}

rule FailPipelinePhase2 {
    when: PipelinePhase2Failed(row, error_message)
    requires: row.job.state = running
    requires: row.state = processing
    requires: row.phase2_status = processing
    ensures: row.phase2_status = error
    ensures: row.state = error
    ensures: row.error_message = error_message
}

rule FailPipelinePhase3 {
    when: PipelinePhase3Failed(row, error_message)
    requires: row.job.state = running
    requires: row.state = processing
    requires: row.phase3_status = processing
    ensures: row.phase3_status = error
    ensures: row.state = error
    ensures: row.error_message = error_message
    ensures:
        if row.job.selected_model = `gpt-image-2`:
            row.job.refunded_generation_units = row.job.refunded_generation_units + usage/config.image_generation_units
            usage/OpenAIPipelineRowFailed(
                reservation: row.job.reservation,
                row_id: row.source_row.id
            )
        if generation_model_is_recraft(row.job.selected_model):
            row.job.refunded_generation_units = row.job.refunded_generation_units + usage/config.image_generation_units
            usage/RecraftPipelineRowFailed(
                reservation: row.job.reservation,
                row_id: row.source_row.id
            )
}

rule OpenProviderQuotaCircuit {
    when: PipelineProviderQuotaExhausted(row, phase, provider, failure_source, error_message)
    requires: row.job.state = running
    requires: row.state = processing
    requires: phase in {phase1, phase2, phase3}
    requires: failure_source in {external_provider_quota, external_provider_billing}
    requires: phase_is_processing(row, phase)
    let deferred_rows = row.job.rows where position > row.position and state = pending
    let refundable_units = deferred_rows.count + 1
    ensures:
        if phase = phase1:
            row.phase1_status = error
        if phase = phase2:
            row.phase2_status = error
        if phase = phase3:
            row.phase3_status = error
    ensures: row.state = provider_error
    ensures: row.error_message = error_message
    ensures: row.job.state = provider_quota_blocked
    ensures: row.job.provider_quota_blocked_at_row_id = row.source_row.id
    ensures: row.job.provider_quota_phase = phase
    ensures: row.job.provider_quota_provider = provider
    ensures: row.job.provider_quota_failure_source = failure_source
    ensures: row.job.refunded_generation_units = row.job.refunded_generation_units + refundable_units
    ensures:
        for deferred in deferred_rows:
            deferred.state = deferred
        usage/PipelineProviderQuotaCircuitOpened(
            reservation: row.job.reservation,
            refundable_units: refundable_units
        )
}

rule CompletePipelineBatch {
    when: PipelineBatchFinished(job)
    requires: job.state = running
    requires: job.rows.all(r => r.state in {completed, error})
    ensures: job.state = completed
}

rule FailPipelineBatchInfrastructure {
    when: PipelineBatchInfrastructureFailed(job)
    requires: job.state = running
    ensures: job.unresolved_after_timeout = true

    @guidance
        -- Preserve pending rows and the running job record so polling can expose
        -- unresolved work after the background-function budget is exceeded.
}

rule ApplyCompletedPipelineRow {
    when: CompletedPipelineRowApplied(pipeline_row)
    requires: pipeline_row.state = completed
    requires: pipeline_row.phase1_status = completed
    requires: pipeline_row.phase2_status = completed
    requires: pipeline_row.phase3_status = completed
    requires: pipeline_row.nlu != null
    requires: pipeline_row.elements != null
    requires: pipeline_row.prompt != null
    requires: pipeline_row.bitmap != null
    ensures: pipeline_row.source_row.nlu = pipeline_row.nlu
    ensures: pipeline_row.source_row.elements = pipeline_row.elements
    ensures: pipeline_row.source_row.prompt = pipeline_row.prompt
    ensures: pipeline_row.source_row.bitmap = pipeline_row.bitmap
    ensures: pipeline_row.source_row.generation_model = pipeline_row.job.selected_model
    ensures: pipeline_row.source_row.generation_quality = pipeline_row.job.selected_quality
    ensures: pipeline_row.source_row.nlu_status = completed
    ensures: pipeline_row.source_row.visual_status = completed
    ensures: pipeline_row.source_row.bitmap_status = completed
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant OneActiveVertexBatchPerLibrary {
    for a in BatchJobs:
        for b in BatchJobs:
            a != b and a.library = b.library implies
                a.state in {completed, failed} or b.state in {completed, failed}
}

invariant ManifestCoversSubmittedRows {
    for job in BatchJobs:
        job.items.count = job.row_count
}

invariant ProviderQuotaBlockedPartition {
    for job in PipelineBatchJobs:
        job.state = provider_quota_blocked implies
            job.provider_quota_blocked_at_row_id != null
            and job.provider_quota_phase in {phase1, phase2, phase3}
            and job.provider_quota_provider != null
            and job.provider_quota_failure_source in {external_provider_quota, external_provider_billing}
            and filter(job.rows, r => r.state = provider_error).count = 1
            and job.rows.all(r => r.state in {completed, error, provider_error, deferred})
            and job.refunded_generation_units =
                filter(job.rows, r => r.state in {provider_error, deferred}).count
                + filter(job.rows, r => r.state = error and r.phase3_status = error
                    and (job.selected_model = `gpt-image-2` or generation_model_is_recraft(job.selected_model))).count
}

invariant DeferredRowsOnlyBelongToBlockedJobs {
    for job in PipelineBatchJobs:
        job.rows.any(r => r.state = deferred) implies job.state = provider_quota_blocked
}

invariant Phase3QuotaErrorRetainsUpstreamArtifacts {
    for row in PipelineBatchRows:
        row.state = provider_error and row.phase3_status = error implies
            row.phase1_status = completed
            and row.phase2_status = completed
            and row.phase3_status = error
            and row.nlu != null
            and row.elements != null
            and row.prompt != null
}

invariant Phase2QuotaErrorRetainsUnderstanding {
    for row in PipelineBatchRows:
        row.state = provider_error and row.phase2_status = error implies
            row.phase1_status = completed and row.nlu != null
}

invariant DeferredRowsWereNotAttempted {
    for row in PipelineBatchRows:
        row.state = deferred implies
            row.phase1_status = idle
            and row.phase2_status = idle
            and row.phase3_status = idle
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface BatchGeneration {
    contracts:
        fulfils VertexBatchBoundary
        fulfils ReferencePictogramBoundary
        fulfils PipelineBatchBoundary
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Should ordinary failed or expired Vertex output lines be refunded, or remain charged as attempts?"
open question "Should identical Vertex prompts be salted to prevent manifest hash collisions?"
open question "May a recurring sequence persona resemble the end user, and what consent would that require?"
