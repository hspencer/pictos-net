-- allium: 3
-- intervention-recording.allium

-- Scope: Recording of user interventions on the semantic AND graphic phases
--   of the pipeline, for research (services/interventionRecording.ts), and
--   the per-row audit panel that gives participants full control over it
--   (components/RowAuditPanel.tsx).
-- Includes:
--   - A per-row intervention log embedded in the row JSON
--   - Sessions bound to row engagement
--   - Edit and discard events on utterance, nlu, elements, prompt, svg_raw,
--     svg_structured
--   - Element operation kinds: add, remove, rename, reorder
--   - SvgMetrics summaries for SVG phases; no SVG content is stored
--   - The "Registrar modificaciones" library setting
--   - Empty sessions dropped at close; no-op edits emit nothing
--   - The row clipboard context header
-- Excludes:
--   - Configuration changes (lang, geoContext, visualStylePrompt, models)
--   - Row management (create, delete, reorder, duplicate, import)
--   - Free-text rationale (captured in the workshop, outside the tool)
--   - Actions on the log itself (read, edit, copy, delete): not recorded
--   - Per-event identity: attribution is the Library's credits field
-- Dependencies: Row and GlobalConfig (types.ts)

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- A pictogram row. Its log travels inside its JSON.
external entity Row {
    engaged: Boolean                -- any engagement surface is active for it
    utterance: String
    log: InterventionLog
}

-- The open library's configuration.
external entity LibraryConfig {
    recording_enabled: Boolean      -- "Registrar modificaciones"; default false
    credits: String?                -- library-level attribution
    lang: String
    ui_lang: String?
    geo_context: String?
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- Lightweight, indicative summary of an SVG artifact.
value SvgMetrics {
    size: Integer                   -- byte length of the SVG string
    entities: Integer               -- path, rect, circle, ellipse, polygon, polyline, line, g
    classes: List<String>           -- sorted set of every class token
    structural_hash: String         -- FNV-1a 32-bit (8 hex) of all path d attributes
}

-- Portability header attached only when a row leaves its library alone.
value RowClipboardContext {
    lang: String
    ui_lang: String?
    geo_context: String?
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum Phase {
    utterance
    | nlu
    | elements
    | prompt
    | svg_raw             -- the raw SVG: native vector output or a trace
    | svg_structured      -- the structured SVG
}

enum EventKind {
    edit                -- the participant changed the artifact by hand
    | discard           -- the artifact was rejected (regenerated or deleted)
}

enum ElementOp {
    add
    | remove
    | rename
    | reorder
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity InterventionLog {
    row: Row
    sessions: InterventionSession with log = this

    active_sessions: sessions where status = active
}

entity InterventionSession {
    log: InterventionLog
    started_at: Timestamp
    ended_at: Timestamp?
    events: InterventionEvent with session = this
    status: active | closed

    transitions status {
        active -> closed
        terminal: closed
    }
}

entity InterventionEvent {
    session: InterventionSession
    event_id: String                -- 8-char hex, stable for curation
    phase: Phase
    kind: EventKind
    at: Timestamp
    op: ElementOp?                  -- present iff phase = elements and kind = edit
    before: String?                 -- verbatim for semantic phases, SvgMetrics for SVG phases
    after: String?                  -- absent on discard
    model_id: String?               -- model that produced a discarded artifact (see open questions)
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- === Sessions ===

rule SessionStart {
    when: row: Row.engaged transitions_to true
    requires: exists LibraryConfig{recording_enabled: true}
    requires: row.log.active_sessions.count = 0
    ensures: InterventionSession.created(log: row.log, started_at: now, status: active)

    @guidance
        -- Engagement surfaces: the row expanded in list view, the focus
        -- modal for it, the SVG editor for it, and the vectorizer modal
        -- for it. The implementation counts only the first three (see open
        -- questions). With recording off no session starts; existing
        -- sessions are untouched. Moving between surfaces of the same row
        -- keeps one session.
}

rule SessionEnd {
    when: row: Row.engaged transitions_to false
    for session in row.log.active_sessions:
        ensures: PendingEditsSettled(row: row)
        ensures:
            if session.events.count = 0:
                not exists session
            else:
                session.status = closed
                session.ended_at = now

    @guidance
        -- Pending semantic edits are settled first, then an empty session
        -- is dropped; only sessions with events are kept.
}

-- === Semantic edits ===

rule SettleSemanticEdits {
    when: PendingEditsSettled(row)
    for session in row.log.active_sessions:
        ensures: SemanticEditsRecorded(session: session)

    @guidance
        -- Settle moments: blur or Enter on a field, just before a
        -- regeneration, and session end. Utterance, NLU and prompt are
        -- compared with the snapshot taken at the last settle; each phase
        -- that differs emits one edit event with before and after verbatim.
        -- Typing, Tab and idle autosave are not commit moments.
}

rule ElementsEdit {
    when: ElementOperationCommitted(row, op, before, after)
    requires: exists LibraryConfig{recording_enabled: true}
    requires: before != after
    for session in row.log.active_sessions:
        ensures: InterventionEvent.created(
            session: session,
            event_id: short_hex_id(),
            phase: elements,
            kind: edit,
            at: now,
            op: op,
            before: before,
            after: after
        )

    @guidance
        -- Recorded eagerly, one event per committed operation with its
        -- explicit kind; a gesture that changes a subtree is one event.
}

-- === Graphic edits ===

rule SvgEditorSave {
    when: SvgEditorSaved(row, phase, before, after)
    requires: exists LibraryConfig{recording_enabled: true}
    requires: before != after
    requires: phase in {svg_raw, svg_structured}
    for session in row.log.active_sessions:
        ensures: InterventionEvent.created(
            session: session,
            event_id: short_hex_id(),
            phase: phase,
            kind: edit,
            at: now,
            before: before,
            after: after
        )

    @guidance
        -- One event per saved editor session, aggregating every operation
        -- inside it: before = SvgMetrics at open, after = SvgMetrics of the
        -- saved SVG. Equal metrics (every field) emit nothing; closing
        -- without saving emits nothing.
}

-- === Discards ===

rule PhaseRegenerationDiscard {
    when: PhaseRegenerated(row, phase, before)
    requires: exists LibraryConfig{recording_enabled: true}
    requires: phase in {nlu, elements, prompt}
    requires: before != null
    for session in row.log.active_sessions:
        ensures: InterventionEvent.created(
            session: session,
            event_id: short_hex_id(),
            phase: phase,
            kind: discard,
            at: now,
            before: before,
            after: null
        )

    @guidance
        -- Regenerating a step, and the cascade after an upstream edit,
        -- each emit one discard per downstream phase that held a value.
        -- The new artifact becomes the baseline of later events. The
        -- implementation sends no model id (see open questions).
}

rule SvgArtifactDiscard {
    when: SvgArtifactDiscarded(row, phase, before)
    requires: exists LibraryConfig{recording_enabled: true}
    requires: phase in {svg_raw, svg_structured}
    for session in row.log.active_sessions:
        ensures: InterventionEvent.created(
            session: session,
            event_id: short_hex_id(),
            phase: phase,
            kind: discard,
            at: now,
            before: before,
            after: null
        )

    @guidance
        -- Fired when the participant deletes a trazado or estructurado
        -- tile, and when re-structuring replaces an existing structured
        -- SVG. The spec also requires it when a fresh trace (Solo trazar /
        -- retrace, or Estructurar from the bitmap) replaces an existing raw
        -- SVG; the implementation does not record that case (see open
        -- questions). First-time trace or structure: nothing to discard.
}

-- === Audit panel ===

rule AuditPanelSave {
    when: AuditLogSaved(row, edited)
    requires: edited.is_valid_log
    ensures: AuditLogReplaced(row: row, log: edited)

    @guidance
        -- Participant curation: drop sessions, redact events. The JSON
        -- must parse and carry a sessions array, else an inline error.
        -- Never auto-saves; closing without Save discards the edit.
}

rule AuditPanelClear {
    when: AuditLogClearConfirmed(row)
    for session in row.log.sessions:
        ensures: not exists session

    @guidance
        -- After an inline confirmation. Only the log is cleared, including
        -- any active session; the row and its media are kept. Later
        -- engagement may start a fresh session.
}

rule CopyRowToClipboard {
    when: CopyRowRequested(row, settings)
    ensures: RowCopied(
        row: row,
        context: RowClipboardContext(lang: settings.lang, ui_lang: settings.ui_lang, geo_context: settings.geo_context)
    )

    @guidance
        -- JSON with schemaVersion, appVersion, type "row-clipboard",
        -- timestamp, context, the row (log included) and its SVG library
        -- entries. The context is the only place lang / uiLang / geoContext
        -- appear beside events; inside a library export the config carries
        -- them once.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant SingleActiveSessionPerRow {
    for log in InterventionLogs:
        log.active_sessions.count <= 1
}

invariant DiscardHasNoAfter {
    for event in InterventionEvents:
        event.kind = discard implies (event.after = null and event.before != null)
}

invariant EditOnElementsHasOp {
    for event in InterventionEvents:
        (event.phase = elements and event.kind = edit) implies event.op != null
}

invariant EventsInsideTheirSession {
    for event in InterventionEvents:
        event.at >= event.session.started_at
        and (event.session.ended_at = null or event.at <= event.session.ended_at)
}

invariant ClosedSessionsAreNotEmpty {
    for session in InterventionSessions:
        session.status = closed implies session.events.count > 0
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface LibraryRecordingControl {
    facing user: LibraryConfig
    context settings: LibraryConfig

    exposes:
        settings.recording_enabled

    @guarantee TogglingOffPreservesCorpus
        -- Turning recording off changes no existing log and asks no
        -- question; turning it on reconstructs nothing. While off, no
        -- session starts and no event is appended, even inside a session
        -- already open.

    @guarantee LogTravelsWithRow
        -- The log is part of the row JSON: every export path (row
        -- clipboard, library download, backup, graph dump) carries it;
        -- deleting the row deletes it. There is no separate corpus file.

    @guarantee AttributionViaCredits
        -- The log carries no participant identifier; attribution is the
        -- library's credits field.

    @guidance
        -- A switch "Registrar modificaciones" / "Record modifications" in
        -- the library configuration panel, with a help tooltip ("Esta
        -- opción permite registrar la auditoría del pictograma, en el caso
        -- que se ajuste y modifique."). Off by default; persisted in the
        -- library config.
}

surface RowAuditPanel {
    facing user: LibraryConfig
    context row: Row

    exposes:
        row.log

    provides:
        AuditLogSaved(row, edited)
        AuditLogClearConfirmed(row)
        CopyRowRequested(row, user)

    @guidance
        -- An audit button in each row footer, next to copy and delete,
        -- always visible regardless of the setting. The modal shows a
        -- summary (sessions, events) or an empty-state line, the log as
        -- editable JSON, and Clear (inline confirmation), Copy (log JSON to
        -- the clipboard) and Save. Escape or close discards unsaved edits.
        -- A marker for the active session was specified but is not built.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- Resolved: attribution is the Library's credits field; events have 8-char hex ids
-- Resolved: events carry no lang / uiLang / geoContext; the clipboard header does
-- Resolved: SVG phases are recorded as SvgMetrics, one event per saved editor session
-- Resolved: regenerations and artifact deletions are discards
-- Resolved: empty sessions are dropped at close; no-op edits emit nothing
-- Superseded: elements recorded the net change at commit; each operation is now recorded eagerly
-- Superseded: structural hash was a truncated SHA-256; it is FNV-1a 32-bit

open question "Engagement: the vectorizer modal is not an engagement surface in the implementation, although the code comment says it is. Opening it from the grid without the row expanded records nothing. Add it?"

open question "A fresh trace replacing an existing raw SVG emits no svg_raw discard (VTracer apply, Estructurar from the bitmap). Record it?"

open question "Discard events never carry a model id. Pass the model that produced the discarded artifact, or drop the field?"

open question "Active-session marker in the audit panel: build it or drop it?"
