-- allium: 3
-- library-manager.allium

-- Scope: Multi-library home screen — the application entry point where users
--   manage independent pictogram libraries, equivalent to a "My Documents" panel.
-- Includes:
--   - Library entity: named, independent storage namespace
--   - Home screen: listing, creation, duplication, download, deletion
--   - Storage usage indicator on the home screen
--   - Bulk backup: ZIP of all library JSONs
--   - Active library: which library is currently open in the editor
--   - Community templates: loaded into fully mutable libraries
-- Excludes:
--   - Library contents (pictograms, sequences) — see visual-reasoning.allium,
--     library-views.allium, sequences.allium
--   - Sequence definition and export — see sequences.allium
--   - Identity, quota, usage tracking — see usage-enforcement.allium
-- Dependencies:
--   - GlobalConfig (gains the active library)
--   - library-views.allium (defines the view opened when a library is active)
--   - sequences.allium (Sequence is a sub-entity of Library)

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- Application-wide configuration. This spec adds the active library; all
-- other fields (lang, uiLang, geoContext, visualStylePrompt, ...) are
-- unchanged. No active library means the home screen is shown.
external entity GlobalConfig {
    active_library: Library?
}

-- A JSON file previously exported by DownloadLibrary or BackupAllLibraries,
-- or a community template served from /public/libraries/.
external entity LibraryFile {
    name: String
    is_valid: Boolean
    pictogram_count: Integer
    sequence_count: Integer
    board_count: Integer
    media_count: Integer
    language: String?
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract LibraryStorageBoundary {
    copy: (library: Library) -> Library

    @invariant LibrariesAreIsolated
        -- Operations on one Library — including deletion — do not affect the
        -- data of any other Library. Each Library owns its pictogram
        -- metadata, media (bitmaps, raw and structured SVGs), sequences and
        -- boards. Media are stored per library and row, so two libraries
        -- that share row ids (a duplicate, a restored backup, a template
        -- loaded twice) never overwrite or delete each other's media.

    @invariant CopiesKeepTheirMedia
        -- Duplicate, download, backup and import carry each pictogram's
        -- media with its metadata. Generated images are not treated as
        -- regenerable: regenerating costs provider calls and changes the
        -- image. A copy never alters the library it was taken from.
        -- (Changed 2026-10-22; copies used to omit media.)

    @invariant CopiesWaitForPendingWrites
        -- A copy reads media only after any media write still in flight from
        -- the last save has finished, so it never captures a partial state.
        -- A failed copy is reported; it is never silent.

    @invariant TemplatesAreNeverMutated
        -- Loading a community template creates a new Library from its JSON;
        -- the template file itself is never changed.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum LibrarySort {
    recientes       -- modified_at descending (default)
    | alfabetico    -- name ascending, case-insensitive
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- A named, self-contained collection of pictograms, sequences and boards.
-- Libraries have no multi-state lifecycle: they exist or are deleted.
entity Library {
    name: String                    -- user-given; always non-empty
    pictogram_count: Integer        -- shown on the home screen card
    sequence_count: Integer
    board_count: Integer
    media_count: Integer            -- pictograms carrying a bitmap or SVG
    language: String?               -- lang of the library config at creation
    source_template: String?        -- template filename; absent if user-created
    created_at: Timestamp
    modified_at: Timestamp          -- updated when pictograms, sequences or boards change
}

-- The application home screen, shown while no library is active.
entity LibraryHome {
    sort: LibrarySort               -- persisted; survives a reload
    storage_used: Integer           -- bytes consumed by all libraries
    storage_estimated: Integer      -- origin storage budget estimated by the browser

    backup_enabled: Libraries.count > 0
}

-- A single-library JSON download.
entity LibraryExport {
    library: Library
    filename: String
    media_count: Integer
    exported_at: Timestamp
}

-- A ZIP with one JSON per library, in the DownloadLibrary format.
entity Backup {
    filename: String
    library_count: Integer
    triggered_at: Timestamp
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    duplicate_suffix: String = " (copia)"
    import_suffix: String = " (importada)"
    backup_filename_prefix: String = "PICTOS-Libraries-"
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- === Home screen ===

rule SortLibraries {
    when: LibrarySortChanged(home, sort)
    ensures: home.sort = sort

    @guidance
        -- Libraries are listed in the chosen order; the default is recientes.
}

-- === Opening and leaving a Library ===

rule OpenLibrary {
    when: OpenLibraryRequested(app, library)
    ensures: app.active_library = library

    @guidance
        -- Triggered by "Abrir" in the card's "..." menu or by a click on the
        -- card body. The Library editor replaces the home screen.
}

rule LeaveLibrary {
    when: LeaveLibraryRequested(app)
    requires: app.active_library != null
    ensures: app.active_library = null

    @guidance
        -- The home screen is shown again with an up-to-date listing.
}

-- === Creating a Library ===

rule CreateLibrary {
    when: CreateLibraryConfirmed(app, name)
    requires: name != ""
    ensures:
        let library = Library.created(
            name: name,
            pictogram_count: 0,
            sequence_count: 0,
            board_count: 0,
            media_count: 0,
            language: null,
            source_template: null,
            created_at: now,
            modified_at: now
        )
        app.active_library = library

    @guidance
        -- "Crear nueva librería" prompts for a name first; cancelling creates
        -- nothing. The new Library opens immediately.
}

-- === Duplicating a Library ===

rule DuplicateLibrary {
    when: DuplicateLibraryRequested(source)
    ensures: Library.created(
        name: source.name + config.duplicate_suffix,
        pictogram_count: source.pictogram_count,
        sequence_count: source.sequence_count,
        board_count: source.board_count,
        media_count: source.media_count,
        language: source.language,
        source_template: source.source_template,
        created_at: now,
        modified_at: now
    )

    @guidance
        -- The duplicate carries the same pictogram metadata (utterances, NLU,
        -- elements, prompts, generation history, phase statuses), sequences,
        -- boards and media (CopiesKeepTheirMedia). It appears on the home
        -- screen and is not opened; the source is unaffected.
}

rule RenameLibrary {
    when: LibraryRenamed(library, name)
    requires: name != ""
    ensures: library.name = name
    ensures: library.modified_at = now

    @guidance
        -- Two paths: inline edit on the home screen card, or the library
        -- settings panel while the library is open. Cancelling or submitting
        -- an empty name leaves the name unchanged.
}

-- === Downloading a Library ===

rule DownloadLibrary {
    when: DownloadLibraryRequested(library)
    ensures: LibraryExport.created(
        library: library,
        filename: sanitize(library.name) + ".json",
        media_count: library.media_count,
        exported_at: now
    )

    @guidance
        -- The JSON contains the library metadata, every pictogram record with
        -- its media, sequences and boards (CopiesKeepTheirMedia).
}

-- === Deleting a Library ===

rule DeleteLibrary {
    when: DeleteLibraryConfirmed(app, library)
    let was_active = app.active_library = library
    ensures: not exists library
    ensures:
        if was_active:
            app.active_library = null

    @guidance
        -- Deletion removes the pictogram metadata, media, sequences and boards
        -- for good, after a destructive-action confirmation. Suggested
        -- prompt (es-419): "¿Eliminar «{name}»? Se borrarán todos los
        -- pictogramas e imágenes generadas. Esta acción no se puede
        -- deshacer." The Delete item in the "..." menu is visually distinct
        -- (e.g. red label) before the prompt appears.
}

-- === Backup and import ===

rule BackupAllLibraries {
    when: BackupRequested(home)
    requires: home.backup_enabled
    ensures: Backup.created(
        filename: config.backup_filename_prefix + date_stamp(now) + ".zip",
        library_count: Libraries.count,
        triggered_at: now
    )

    @guidance
        -- One JSON per library in the DownloadLibrary format, media included.
        -- The download fires without a blocking progress modal.
}

rule ImportLibrary {
    when: ImportLibraryRequested(app, file)
    requires: file.is_valid
    ensures:
        let library = Library.created(
            name: import_name(file.name, config.import_suffix),
            pictogram_count: file.pictogram_count,
            sequence_count: file.sequence_count,
            board_count: file.board_count,
            media_count: file.media_count,
            language: file.language,
            source_template: null,
            created_at: now,
            modified_at: now
        )
        app.active_library = library

    @guidance
        -- The imported library gets a fresh id (the id in the JSON is not
        -- reused) and carries the file's pictograms with their media,
        -- sequences and boards. import_name appends the suffix when a library
        -- with that name exists. The imported library opens immediately
        -- (aligned with the implementation, 2026-10-23). "Importar librería"
        -- is a home screen action, never inside an open library: import
        -- creates a new library and never replaces an existing one.
}

rule RejectInvalidImport {
    when: ImportLibraryRequested(app, file)
    requires: not file.is_valid
    ensures: ImportFailureShown(file: file)

    @guidance
        -- The error is shown inline; no library is created.
}

-- === Community templates ===

rule LoadCommunityTemplate {
    when: TemplateLoadRequested(app, template)
    ensures:
        let library = Library.created(
            name: template.name,
            pictogram_count: template.pictogram_count,
            sequence_count: template.sequence_count,
            board_count: template.board_count,
            media_count: template.media_count,
            language: template.language,
            source_template: template.name,
            created_at: now,
            modified_at: now
        )
        app.active_library = library

    @guidance
        -- Templates are JSON files in /public/libraries/, shown in a separate
        -- "De la comunidad" section, not pre-created libraries. The loaded
        -- library is fully mutable (TemplatesAreNeverMutated). Template cards
        -- can be hidden individually and restored with "Restaurar plantillas".
        -- First launch shows the home screen; no library opens by itself.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant LibraryNameIsNonEmpty {
    for library in Libraries:
        library.name != ""
}

invariant CountsAreNonNegative {
    for library in Libraries:
        library.pictogram_count >= 0
        and library.sequence_count >= 0
        and library.board_count >= 0
        and library.media_count >= 0
        and library.media_count <= library.pictogram_count
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface LibraryHomeScreen {
    facing visitor: GlobalConfig
    context home: LibraryHome

    exposes:
        home.sort
        home.storage_used
        home.storage_estimated
        home.backup_enabled
        for library in Libraries:
            library.name
            library.pictogram_count
            library.modified_at

    provides:
        LibrarySortChanged(home, sort)
        OpenLibraryRequested(visitor, library)
        CreateLibraryConfirmed(visitor, name)
        DuplicateLibraryRequested(library)
        DownloadLibraryRequested(library)
        DeleteLibraryConfirmed(visitor, library)
        BackupRequested(home) when home.backup_enabled
        ImportLibraryRequested(visitor, file)
        TemplateLoadRequested(visitor, template)

    @guarantee StorageIndicatorIsInformational
        -- The indicator shows used and estimated storage in readable units
        -- (MB or GB) and updates after any creation, duplication or deletion.
        -- No hard limit blocks library creation.

    @guidance
        -- Responsive card grid: name, pictogram count, last-modified date and
        -- the "..." menu (Abrir, Duplicar, Descargar, Eliminar; Eliminar in
        -- red). The "Crear nueva librería" block has a dashed border and a
        -- "+" icon. Below the grid: storage indicator, then "Respaldar
        -- librerías". Indicator copy (es-419): "Almacenamiento: X MB de Y MB
        -- usados", amber above 80% of the estimate, not a progress bar. Empty
        -- state: only the create block and "Crea tu primera librería de
        -- pictogramas."
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- Resolved: example libraries are fully mutable (editable + deletable)
-- Resolved 2026-10-22: duplicate, download, backup and import carry media
-- Resolved: backup filename: PICTOS-Libraries-{YYYY-MM-DD}.zip
-- Resolved: storage indicator is informational (no hard creation block)
-- Resolved: creating a new library prompts for a name before persisting
-- Resolved: duplicate name pattern: "{original} (copia)"
-- Resolved: rename via the home screen card and the library settings panel
-- Resolved: sort control LibrarySort { recientes | alfabetico }, default recientes, persisted
-- Resolved: import is a home screen action that creates a new library and opens it
-- Resolved: first launch always shows the home screen

open question "Library settings panel: the rename-from-settings path implies a settings panel inside the open library editor; its fields and placement are not yet specified."
