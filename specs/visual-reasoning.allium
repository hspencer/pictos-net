-- allium: 3
-- visual-reasoning.allium

use "./generation-config.allium" as generation
use "./svg-structuring.allium" as structured

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity GlobalConfig {
    lang: String
    domain_context: String?
    visual_style_prompt: String
    comprender_model: NLUModel?
    componer_model: NLUModel?
    legacy_nlu_model: NLUModel?
    generation_model: generation/GenerationModel
    openai_image_quality: generation/OpenAIImageQuality?
    phase5_model: generation/Phase5StructuringModel?
    recording_enabled: Boolean
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value NLUMetadata {
    speech_act: String
    intent: String
    timestamp: String?
    speaker_id: String?
}

value RoleFiller {
    type: String
    ref: String?
    surface: String?
    lemma: String?
    definiteness: String?
    ref_frame: String?
}

value SemanticFrame {
    frame_name: String
    frame_label: String?
    lexical_unit: String
    roles: Map<String, RoleFiller>
    id: String?
}

value VisualGuidelines {
    focus_actor: String?
    secondary_actor: String?
    action_core: String?
    object_core: String?
    context: String?
    temporal: String?
    salience: Map<String, Decimal>?
}

value LogicalForm {
    event: String
    modality: String?
    negation: Boolean?
    aspect: String?
    tense: String?
}

value Pragmatics {
    politeness: String?
    formality: String?
    expected_response: String?
    urgency: String?
    speaker_stance: String?
}

value NLUData {
    utterance: String
    lang: String
    domain: String?
    metadata: NLUMetadata?
    frames: List<SemanticFrame>
    visual_guidelines: VisualGuidelines?
    nsm_explications: Map<String, String>?
    logical_form: LogicalForm
    pragmatics: Pragmatics?
}

-- Optionality above describes the historical document contract. The new
-- generation profile is validated separately against the canonical product;
-- a legacy document is not relabelled as newly generated by being readable.

value VisualElement {
    id: String
    concept: VisualConcept
    children: List<VisualElement>?
}

value CompositionArtifact {
    elements: List<VisualElement>
    prompt: String
}

value ContractValidation {
    valid: Boolean
    schema_id: String
    schema_version: String
    schema_hash: String
    issues: List<String>
}

value Phase3InputSnapshot {
    utterance: String
    nlu: NLUData
    elements: List<VisualElement>
    prompt: String
}

value StructuringGroup {
    node_id: String
    label: String
    css_class: String
    parent_id: String?
    kept_path_ids: List<String>
    merge_source_ids: List<String>
    selected: Boolean
}

value StructuringMapping {
    description: String
    groups: List<StructuringGroup>
    discarded_path_ids: List<String>
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract UnderstandingBoundary {
    understand: (utterance: String, config: GlobalConfig) -> NLUData

    @invariant ForcedStructuredOutput
        -- Provider tool forcing constrains delivery, not acceptance. Every new
        -- Phase 1 result undergoes runtime validation against the generation
        -- profile of the canonical schemas/nlu-schema product. Invalid fields,
        -- unresolved local frame references, or malformed NSM data fail the
        -- phase; normalization cannot silently discard semantic content.
        -- Optional domain remains optional. Historical NSM_explications is
        -- retained on legacy import; new generation uses nsm_explications.

    @invariant SharedFullDocumentContract
        -- Individual and batch paths use the same canonical contract and
        -- validator. Phase 2 receives the complete accepted NLU document,
        -- including metadata, frames, roles, logical_form, pragmatics, NSM,
        -- and visual_guidelines when present, not a lossy summary projection.

    @invariant FailedValidationPreservesPriorArtifacts
        -- Invalid output never replaces a prior accepted NLU or composition.
        -- The phase is visibly failed and cannot advance automatically. Any
        -- captured raw response is an unvalidated diagnostic, never accepted
        -- corpus truth. Historical read/import does not assert current validity.

    @invariant ContextPrecedence
        -- Domain context is the primary semantic instruction. Visual style is a
        -- secondary hint and never replaces the communicative intention.

    @invariant UnderstandingModelRouting
        -- The effective model is comprender_model, then legacy_nlu_model, then
        -- Claude Haiku. Claude models use the Claude boundary; Gemini text
        -- models use the Gemini NLU boundary. OpenAI text models use their
        -- own server boundary with the same canonical acceptance validator.
}

contract CompositionBoundary {
    compose: (nlu: NLUData, config: GlobalConfig) -> CompositionArtifact

    @invariant SingleResponseForTreeAndPrompt
        -- One forced compose_pictogram response yields semantic children and
        -- the spatial prompt together.

    @invariant DeterministicSyntheticRoot
        -- Local normalization injects exactly one root named pictograma for
        -- Spanish or pictogram for English. The model never returns that root.
        -- Provider children and the persisted rooted artifact have separate
        -- canonical schema definitions. Both are validated before acceptance.

    @invariant NoPhantomElements
        -- Missing, duplicate, or unusable identifiers fail validation. No
        -- semantic element is silently dropped and no unknown or fabricated
        -- placeholder is introduced. All referenced element ids must exist.

    @invariant SharedCompositionContract
        -- Individual and batch paths consume schemas/pictogram-composition-schema
        -- as the sole contract source. Recursive children are validated at
        -- every depth; a forced compose_pictogram call is not that validation.
        -- Phase 2 output is a composition artifact, never a Phase 5 mapping.

    @invariant EveryElementAppearsInRegeneratedPrompt
        -- Prompt regeneration uses the current tree and quotes every current
        -- element id. Invalid output fails canonical validation and preserves
        -- the accepted prompt; no automatic corrective model call is added.

    @invariant CompositionModelRouting
        -- The effective model is componer_model, then legacy_nlu_model, then
        -- Claude Haiku, routed by provider family independently of Phase 1.
        -- OpenAI follows the same shared full-document contract in individual
        -- and batch execution; provider choice never removes semantic fields.
}

contract OpenAITextBoundary {
    generate: (request: Any) -> Any

    @invariant CanonicalMeaningSurvivesTransport
        -- Responses function calling carries the existing semantic tools with
        -- strict:false explicitly, a forced function name and parallel calls
        -- disabled. Dynamic role/NSM/salience maps keep their canonical shape;
        -- they are not stringified or changed to arrays to claim provider-side
        -- strictness. The canonical validator remains the acceptance authority.
        -- A function used to deliver output requires no second model call.

    @invariant CompleteResponseRequired
        -- Accept only a completed response without refusal or provider error.
        -- Tool-based phases require exactly the expected function, parseable
        -- complete JSON arguments and the phase's canonical validation. Plain
        -- text routes accept only actual text content; reasoning items are not
        -- response text or research provenance. Incomplete, missing, malformed
        -- or wrong-tool output fails while preserving prior accepted artifacts.

    @invariant TextVisionAndRedrawShareTheBoundary
        -- Phase 1, Phase 2, spatial-prompt regeneration and Phase 5 use the same
        -- model/phase admission and error/usage semantics in individual and
        -- batch callers. Vision inputs retain their actual media type and
        -- supported image content. Explicit SVG redraw still passes final SVG
        -- conformance; a vision response is not permission to bypass it.

    @invariant StatelessAndBounded
        -- Requests use store:false, explicit low reasoning effort and a finite
        -- output-token bound, with no web tools or conversation persistence.
        -- The bound includes reasoning tokens. No automatic semantic retry or
        -- higher output limit is introduced after refusal or invalid output.
        -- Provider data-retention controls remain separate; store:false alone
        -- is not a claim of zero retention or sovereign local execution.
}

contract Phase3GenerationBoundary {
    generate: (snapshot: Phase3InputSnapshot, model: generation/GenerationModel, quality: generation/OpenAIImageQuality?) -> String

    @invariant CoherentSnapshot
        -- Utterance, current NLU, current elements, and current prompt are read
        -- atomically at trigger time. An in-flight call never mixes versions.

    @invariant SquareArtifact
        -- Bitmap models produce square PNG; the vector model produces native
        -- square SVG. A vector response never embeds a raster image.

    @invariant OpenAIUsesTheCompleteTextPrompt
        -- GPT Image 2 consumes the same textual prompt composition as Gemini:
        -- semantic snapshot, element identities, spatial instructions, visual
        -- style, palette, and communicative intention. No JSON schema, function
        -- call, or XML output is required from the image model. Image editing
        -- and reference-image input are outside this integration.

    @invariant OpenAIOutputAndQuality
        -- GPT Image 2 returns one square PNG at the configured image size.
        -- Quality is frozen at trigger time, defaults to low when absent, and
        -- is recorded with the model only after successful generation.

    @invariant AllPhase3EntryPointsShareRouting
        -- Individual generation, sequence-step generation, cascade, retry,
        -- bulk regeneration, and full-pipeline batches route GPT Image 2 to
        -- OpenAI while retaining the same complete semantic inputs.

    @invariant BackgroundExecution
        -- Phase 3 runs as a background job. Elapsed time starts at the trigger,
        -- remains stable across navigation, and Stop is available while running.

    @invariant RetryOnlyPhase3
        -- Retrying a Phase 3 error does not execute Phase 1 or Phase 2 and does
        -- not discard their completed artifacts or statuses.

    @invariant NoSilentModelFallback
        -- A terminal Gemini or OpenAI provider 429 after configured retries is recoverable,
        -- remains attributed to the selected model, and never invokes another
        -- Gemini, OpenAI, or Recraft model automatically.
}

contract VectorizationBoundary {
    vectorize: (bitmap: String) -> String

    @invariant LocalAndUserTriggered
        -- VTracer runs locally and only after an explicit user action. It makes
        -- no provider call, charges no quota, and preserves the source bitmap.
}

contract StructuringBoundary {
    structure: (raw_svg: String, elements: List<VisualElement>) -> StructuringMapping
    assemble_revision: (input: structured/StructuringInput, mapping: StructuringMapping) -> String

    @invariant OneModelCall
        -- Phase 5 makes one forced restructure_svg call per trigger, without an
        -- automatic retry loop.

    @invariant NLUExcluded
        -- Utterance, frames, pragmatics, domain, and visual guidelines are not
        -- sent to the structuring model. It receives visual evidence and elements.
        -- This restriction concerns the regrouping model request. Local final
        -- assembly receives and embeds the complete accepted NLU and complete
        -- composition including its prompt, plus actually known provenance.

    @invariant GeometryRemainsLocal
        -- The model returns path ids and optional merge sources, never path
        -- geometry. Kept geometry comes verbatim from raw SVG; accepted merges
        -- are computed locally after IoU, area, and fill-role validation.

    @invariant MergeFailureIsNonBlocking
        -- An invalid merge silently falls back to its original paths and does
        -- not change the Phase 5 status to error.

    @invariant RecordingReviewIsTimed
        -- Recording mode opens mandatory review with all groups selected,
        -- editable labels, a bounded reading-time timer, and early confirmation.

    @invariant ReviewDurationFormula
        -- Review duration is three times the 200-words-per-minute reading time
        -- for all group labels and node ids, clamped from 10 to 90 seconds.

    @invariant AccessibleSchemaAssembly
        -- Selected semantic groups reproduce the element hierarchy, expose group
        -- roles and editable labels, use palette CSS classes without inline fill,
        -- retain unassigned paths in a context group, and conform to mf-svg.
        -- Retaining unassigned geometry preserves a draft, not evidence of a
        -- known Context concept. Conformance is determined after all final
        -- post-processing under the versioned structured artifact contract.

    @invariant FinalRevisionAcceptance
        -- Every entry point, reviewed assembly, redraw and editor save uses
        -- the same final validation boundary. A failed candidate remains
        -- available as a diagnostic draft, preserving the previous accepted
        -- SVG. XML parsing or a confirmed mapping alone cannot mark completion.
        -- Only exact validated final bytes acquire a canonical hash reference.
        -- Import preserves old references as untrusted claims: hash and schema
        -- must be revalidated before using them as verified authority.

    @invariant WorkspaceChangesInvalidateCurrentAuthority
        -- An edit to upstream semantics, composition, prompt or SVG makes the
        -- old current-reference association stale. The earlier SVG remains
        -- available as its own revision; it cannot certify the changed row.
        -- Regeneration does not inherit human review. A late result cannot
        -- overwrite a newer workspace snapshot as if it described that state.

    @invariant FidelityPrefersLessLoss
        -- Before completion, path coverage is compared with raw SVG. If needed,
        -- a merge-free assembly replaces a lossier merged result.

    @invariant ConsoleTraceIsComplete
        -- Console output records prompt, image summary, model, duration, HTTP
        -- status, token use, group assignment, discards, and merge decisions.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum StepStatus { idle | processing | completed | error | outdated }
enum NLUModel {
    `claude-haiku-4-5-20251001` |
    `claude-sonnet-4-6` |
    `gemini-2.5-flash` |
    `gemini-2.5-pro` |
    `gpt-5.6-luna` |
    `gpt-5.6-terra` |
    `gpt-5.6-sol`
}
enum VisualConcept { root | agent | action | object | context | element }
enum Phase3AttemptStatus { processing | completed | error | cancelled }
enum Phase3FailureKind { generation_error | external_provider_quota }
enum Phase3ArtifactKind { bitmap | vector }
enum Phase5AttemptStatus { processing | review | completed | error }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity VisualReasoning {
    config: GlobalConfig
    utterance: String
    nlu: NLUData?
    nlu_status: StepStatus
    elements: List<VisualElement>?
    prompt: String?
    visual_status: StepStatus
    bitmap: String?
    raw_svg: String?
    generation_model: generation/GenerationModel?
    generation_quality: generation/OpenAIImageQuality?
    bitmap_status: StepStatus
    structured_svg: String?
    structured_svg_reference: structured/RevisionReference?
    structured_svg_status: StepStatus
    audio: String?
    active_phase3_attempt: Phase3Attempt?
    active_phase5_attempt: Phase5Attempt?
}

entity Phase3Attempt {
    reasoning: VisualReasoning
    snapshot: Phase3InputSnapshot
    selected_model: generation/GenerationModel
    selected_quality: generation/OpenAIImageQuality?
    artifact_kind: Phase3ArtifactKind
    status: Phase3AttemptStatus
    failure_kind: Phase3FailureKind?
    recoverable: Boolean
    generation_unit_refunded: Boolean
    started_at: Timestamp
}

entity Phase5Attempt {
    reasoning: VisualReasoning
    selected_model: generation/Phase5StructuringModel
    status: Phase5AttemptStatus
    mapping: StructuringMapping?
    review_duration: Duration?
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    openai_image_size: Integer = 1024
    default_nlu_model: NLUModel = `claude-haiku-4-5-20251001`
    phase5_review_reading_wpm: Integer = 200
    phase5_review_multiplier: Integer = 3
    phase5_review_minimum: Duration = 10.seconds
    phase5_review_maximum: Duration = 90.seconds
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule StartUnderstanding {
    when: Phase1Requested(reasoning)
    requires: reasoning.utterance != ""
    ensures: reasoning.nlu_status = processing
}

rule CompleteUnderstanding {
    when: Phase1Succeeded(reasoning, nlu, validation)
    requires: reasoning.nlu_status = processing
    requires: validation.valid
    requires: canonical_nlu_valid(nlu, validation)
    ensures: reasoning.nlu = nlu
    ensures: reasoning.nlu_status = completed
    ensures:
        if reasoning.visual_status in {completed, error}:
            reasoning.visual_status = outdated
        if reasoning.bitmap_status in {completed, error}:
            reasoning.bitmap_status = outdated
        if reasoning.structured_svg_status in {completed, error}:
            reasoning.structured_svg_status = outdated
}

rule FailUnderstanding {
    when: Phase1Failed(reasoning)
    requires: reasoning.nlu_status = processing
    ensures: reasoning.nlu_status = error
}

rule StartComposition {
    when: Phase2Requested(reasoning)
    requires: reasoning.nlu_status = completed
    requires: reasoning.nlu != null
    ensures: reasoning.visual_status = processing
}

rule CompleteComposition {
    when: Phase2Succeeded(reasoning, composition, validation)
    requires: reasoning.visual_status = processing
    requires: validation.valid
    requires: canonical_composition_valid(composition, validation)
    requires: composition.elements.count > 0
    requires: composition.prompt != ""
    ensures: reasoning.elements = composition.elements
    ensures: reasoning.prompt = composition.prompt
    ensures: reasoning.visual_status = completed
    ensures:
        if reasoning.bitmap_status in {completed, error}:
            reasoning.bitmap_status = outdated
        if reasoning.structured_svg_status in {completed, error}:
            reasoning.structured_svg_status = outdated
}

rule FailComposition {
    when: Phase2Failed(reasoning)
    requires: reasoning.visual_status = processing
    ensures: reasoning.visual_status = error
}

rule RejectInvalidUnderstanding {
    when: Phase1ValidationFailed(reasoning, validation)
    requires: reasoning.nlu_status = processing
    requires: not validation.valid
    ensures: reasoning.nlu_status = error
}

rule RejectInvalidComposition {
    when: Phase2ValidationFailed(reasoning, validation)
    requires: reasoning.visual_status = processing
    requires: not validation.valid
    ensures: reasoning.visual_status = error
}

rule RegenerateSpatialPrompt {
    when: SpatialPromptRegenerationRequested(reasoning, prompt)
    requires: reasoning.nlu != null
    requires: reasoning.elements != null
    requires: reasoning.elements.count > 0
    requires: prompt != ""
    requires: current_composition_with_prompt_valid(reasoning.elements, prompt)
    ensures: reasoning.prompt = prompt
    ensures: reasoning.visual_status = completed
    ensures: reasoning.bitmap_status = outdated
    ensures:
        if reasoning.structured_svg_status in {completed, error}:
            reasoning.structured_svg_status = outdated
}

rule StartBitmapPhase3 {
    when: BitmapPhase3Requested(reasoning)
    requires: reasoning.nlu_status = completed
    requires: reasoning.visual_status = completed
    requires: reasoning.nlu != null
    requires: reasoning.elements != null
    requires: reasoning.prompt != null
    requires: not generation_model_is_vector(reasoning.config.generation_model)
    ensures:
        let attempt = Phase3Attempt.created(
            reasoning: reasoning,
            snapshot: {
                utterance: reasoning.utterance,
                nlu: reasoning.nlu,
                elements: reasoning.elements,
                prompt: reasoning.prompt
            },
            selected_model: reasoning.config.generation_model,
            selected_quality: effective_openai_quality(reasoning.config),
            artifact_kind: bitmap,
            status: processing,
            failure_kind: null,
            recoverable: false,
            generation_unit_refunded: false,
            started_at: now
        )
        reasoning.active_phase3_attempt = attempt
        reasoning.bitmap_status = processing
}

rule StartVectorPhase3 {
    when: VectorPhase3Requested(reasoning)
    requires: reasoning.nlu_status = completed
    requires: reasoning.visual_status = completed
    requires: reasoning.nlu != null
    requires: reasoning.elements != null
    requires: reasoning.prompt != null
    requires: generation_model_is_vector(reasoning.config.generation_model)
    ensures:
        let attempt = Phase3Attempt.created(
            reasoning: reasoning,
            snapshot: {
                utterance: reasoning.utterance,
                nlu: reasoning.nlu,
                elements: reasoning.elements,
                prompt: reasoning.prompt
            },
            selected_model: reasoning.config.generation_model,
            selected_quality: null,
            artifact_kind: vector,
            status: processing,
            failure_kind: null,
            recoverable: false,
            generation_unit_refunded: false,
            started_at: now
        )
        reasoning.active_phase3_attempt = attempt
        reasoning.bitmap_status = processing
}

rule CompleteBitmapPhase3 {
    when: BitmapPhase3Succeeded(attempt, bitmap_artifact)
    requires: attempt.status = processing
    requires: attempt.artifact_kind = bitmap
    ensures: attempt.status = completed
    ensures: attempt.reasoning.bitmap = bitmap_artifact
    ensures: attempt.reasoning.raw_svg = null
    ensures: attempt.reasoning.structured_svg = null
    ensures: attempt.reasoning.generation_model = attempt.selected_model
    ensures: attempt.reasoning.generation_quality = attempt.selected_quality
    ensures: attempt.reasoning.bitmap_status = completed
    ensures:
        if attempt.reasoning.structured_svg_status in {completed, error}:
            attempt.reasoning.structured_svg_status = outdated
}

rule CompleteVectorPhase3 {
    when: VectorPhase3Succeeded(attempt, svg_artifact)
    requires: attempt.status = processing
    requires: attempt.artifact_kind = vector
    ensures: attempt.status = completed
    ensures: attempt.reasoning.raw_svg = svg_artifact
    ensures: attempt.reasoning.bitmap = null
    ensures: attempt.reasoning.structured_svg = null
    ensures: attempt.reasoning.generation_model = attempt.selected_model
    ensures: attempt.reasoning.generation_quality = null
    ensures: attempt.reasoning.bitmap_status = completed
    ensures:
        if attempt.reasoning.structured_svg_status in {completed, error}:
            attempt.reasoning.structured_svg_status = outdated
}

rule FailPhase3 {
    when: Phase3Failed(attempt)
    requires: attempt.status = processing
    ensures: attempt.status = error
    ensures: attempt.failure_kind = generation_error
    ensures: attempt.recoverable = true
    ensures: attempt.reasoning.bitmap_status = error
    ensures: attempt.reasoning.nlu_status = completed
    ensures: attempt.reasoning.visual_status = completed
    ensures:
        if attempt.selected_model = `gpt-image-2`:
            attempt.generation_unit_refunded = true
}

rule TerminalImageProviderQuota {
    when: ImageProviderQuotaExhausted(attempt)
    requires: attempt.status = processing
    requires: attempt.selected_model in {
        `gemini-2.5-flash-image`,
        `gemini-3.1-flash-image`,
        `gemini-3-pro-image`,
        `gpt-image-2`
    }
    ensures: attempt.status = error
    ensures: attempt.failure_kind = external_provider_quota
    ensures: attempt.recoverable = true
    ensures: attempt.generation_unit_refunded = true
    ensures: attempt.reasoning.bitmap_status = error
    ensures: attempt.reasoning.nlu_status = completed
    ensures: attempt.reasoning.visual_status = completed
}

rule RetryBitmapPhase3Only {
    when: BitmapPhase3RetryRequested(reasoning)
    requires: reasoning.bitmap_status = error
    requires: reasoning.nlu_status = completed
    requires: reasoning.visual_status = completed
    requires: reasoning.nlu != null
    requires: reasoning.elements != null
    requires: reasoning.prompt != null
    requires: not generation_model_is_vector(reasoning.config.generation_model)
    ensures:
        let attempt = Phase3Attempt.created(
            reasoning: reasoning,
            snapshot: {
                utterance: reasoning.utterance,
                nlu: reasoning.nlu,
                elements: reasoning.elements,
                prompt: reasoning.prompt
            },
            selected_model: reasoning.config.generation_model,
            selected_quality: effective_openai_quality(reasoning.config),
            artifact_kind: bitmap,
            status: processing,
            failure_kind: null,
            recoverable: false,
            generation_unit_refunded: false,
            started_at: now
        )
        reasoning.active_phase3_attempt = attempt
        reasoning.bitmap_status = processing
        reasoning.nlu_status = completed
        reasoning.visual_status = completed
}

rule StopPhase3 {
    when: StopPhase3Requested(attempt)
    requires: attempt.status = processing
    ensures: attempt.status = cancelled
    ensures: attempt.reasoning.bitmap_status = idle
    ensures: attempt.reasoning.bitmap = null
    ensures: attempt.reasoning.raw_svg = null
}

rule VectorizeBitmapLocally {
    when: VectorizationSucceeded(reasoning, svg_artifact)
    requires: reasoning.bitmap_status = completed
    requires: reasoning.bitmap != null
    requires: not generation_model_is_vector(reasoning.generation_model)
    ensures: reasoning.raw_svg = svg_artifact
}

rule StartPhase5 {
    when: Phase5Requested(reasoning, selected_model)
    requires: reasoning.raw_svg != null
    requires: reasoning.nlu != null
    requires: reasoning.elements != null
    requires: reasoning.prompt != null
    ensures:
        let attempt = Phase5Attempt.created(
            reasoning: reasoning,
            selected_model: selected_model,
            status: processing,
            mapping: null,
            review_duration: null
        )
        reasoning.active_phase5_attempt = attempt
        reasoning.structured_svg_status = processing
}

rule BeginPhase5Review {
    when: Phase5MappingReturned(attempt, mapping, review_duration)
    requires: attempt.status = processing
    requires: attempt.reasoning.config.recording_enabled
    requires: review_duration >= config.phase5_review_minimum
    requires: review_duration <= config.phase5_review_maximum
    ensures: attempt.mapping = mapping
    ensures: attempt.review_duration = review_duration
    ensures: attempt.status = review
}

rule CompletePhase5WithoutReview {
    when: Phase5AssemblySucceeded(attempt, mapping, structured_svg, conformance)
    requires: attempt.status = processing
    requires: not attempt.reasoning.config.recording_enabled
    requires: conformance.valid
    requires: canonical_structured_svg_valid(structured_svg, conformance)
    ensures: attempt.mapping = mapping
    ensures: attempt.status = completed
    ensures: attempt.reasoning.structured_svg = structured_svg
    ensures: attempt.reasoning.structured_svg_status = completed
    ensures: attempt.reasoning.structured_svg_reference = {
        profile_version: conformance.profile_version,
        content_hash: conformance.content_hash
    }
}

rule ConfirmPhase5Review {
    when: Phase5ReviewConfirmed(attempt, reviewed_mapping, structured_svg, conformance)
    requires: attempt.status = review
    requires: conformance.valid
    requires: canonical_structured_svg_valid(structured_svg, conformance)
    ensures: attempt.mapping = reviewed_mapping
    ensures: attempt.status = completed
    ensures: attempt.reasoning.structured_svg = structured_svg
    ensures: attempt.reasoning.structured_svg_status = completed
    ensures: attempt.reasoning.structured_svg_reference = {
        profile_version: conformance.profile_version,
        content_hash: conformance.content_hash
    }
}

rule FailPhase5 {
    when: Phase5Failed(attempt)
    requires: attempt.status in {processing, review}
    ensures: attempt.status = error
    ensures: attempt.reasoning.structured_svg_status = error
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant Phase3ErrorRetainsCompletedUpstream {
    for attempt in Phase3Attempts:
        attempt.status = error implies
            attempt.reasoning.nlu_status = completed
            and attempt.reasoning.visual_status = completed
            and attempt.reasoning.nlu != null
            and attempt.reasoning.elements != null
            and attempt.reasoning.prompt != null
}

invariant ProviderQuotaRefundsSelectedAttempt {
    for attempt in Phase3Attempts:
        attempt.failure_kind = external_provider_quota implies
            attempt.recoverable and attempt.generation_unit_refunded
}

invariant DownstreamOutdatedWithoutGaps {
    for reasoning in VisualReasonings:
        reasoning.nlu_status = outdated implies
            reasoning.visual_status in {idle, outdated}
            and reasoning.bitmap_status in {idle, outdated}
            and reasoning.structured_svg_status in {idle, outdated}
}

invariant NativeSvgIsNeverBitmapModelOutput {
    for attempt in Phase3Attempts:
        attempt.artifact_kind = vector implies
            generation_model_is_vector(attempt.selected_model)
}

invariant OpenAIQualitySnapshot {
    for attempt in Phase3Attempts:
        (attempt.selected_model = `gpt-image-2` implies attempt.selected_quality != null)
        and (attempt.selected_model != `gpt-image-2` implies attempt.selected_quality = null)
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface VisualReasoningPipeline {
    contracts:
        fulfils OpenAITextBoundary
        fulfils UnderstandingBoundary
        fulfils CompositionBoundary
        fulfils Phase3GenerationBoundary
        fulfils VectorizationBoundary
        fulfils StructuringBoundary
        fulfils structured/PortablePictogramRevision
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- Resolved: new composition is validated at the Phase 2 acceptance boundary.
-- Phase 5 can additionally validate its input; it is not the first validator.
-- Resolved: absent geometry does not require an invented empty action group.
-- Explicitly supplied implicit bindings are allowed; otherwise the node stays
-- unresolved in the retained complete composition, not silently inferred.
open question "Should Phase 5 review include a minimum time per semantic node?"
open question "Should confirmed Phase 5 review data be retained as a future training tuple?"
open question "Should Phase 5 review allow individual path selection within a semantic node?"
