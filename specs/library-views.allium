-- allium: 3
-- library-views.allium

-- Scope: Visual presentation and layout of the open Library in pictogramas
--   mode — row list and grid views — plus the focused view of a single row
--   (FocusViewModal).
-- Includes:
--   - The library view mode (list | grid), default and persistence
--   - Row ordering shared by both views
--   - The grid cell composition, click and hover model
--   - Expanded row layout constraints (list view)
--   - Artifact stacking in the row list
--   - Stage labels on artifacts
--   - The four steps of FocusViewModal (nlu, visual, producir, format), with
--     the producir and format step contents
-- Excludes:
--   - The home screen and library management — see library-manager.allium
--   - Sequences and boards content modes — see sequences.allium, boards.allium
--   - Steps 1 and 2 editing UIs (NLU editor, elements editor)
--   - Bitmap editing — no tool implemented (see open questions)
--   - The SVG editor's internal behaviour — see vector-editor.allium. The
--     editor edits whatever SVG a slot holds, independent of its origin.
--   - Structuring internals — see svg-structuring.allium
-- Trace status: Vectorizar is no longer a pipeline phase. The default
--   Producir model (gpt-image-2.5-flare) and Gemini emit a bitmap; only the
--   Recraft "_vector" models emit native SVG. On a bitmap row, Estructurar
--   (UI phase 4, internal id 5) starts from the bitmap and writes its region
--   trace to rawSvg; "Solo trazar" / retrace (the legacy VTracer modal) is a
--   separate, user-initiated trace-only action.
-- Dependencies:
--   - Row (visual-reasoning.allium)
--   - LibraryConfig: the open library's GlobalConfig (library-manager.allium)

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- The pictogram row managed by the main app. This spec reads its artifacts
-- and statuses; mutations go through the existing pipeline handlers.
external entity Row {
    utterance: String
    bitmap: String?                 -- present iff Producir used a bitmap model
    raw_svg: String?                -- native SVG from a vector model, or a trace of the bitmap
    structured_svg: String?         -- present iff Estructurar produced an accepted result
    structured_svg_draft: String?   -- a non-certified Estructurar result
    is_vector_model: Boolean        -- generation model emits native SVG
    is_processing: Boolean
}

-- The open library's configuration. This spec adds one field.
external entity LibraryConfig {
    view_mode: LibraryViewMode      -- persisted with the library config, so per library
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum LibraryViewMode {
    list            -- the row list (default)
    | grid          -- the pictogram grid
}

enum PictogramStage {
    none            -- no image yet
    | bitmap        -- raster from Producir
    | trazado       -- raw SVG: native vector output or a trace of the bitmap
    | estructurado  -- semantic SVG from Estructurar
}

enum FocusStep {
    nlu             -- step 1: Comprender
    | visual        -- step 2: Componer (elements + prompt)
    | producir      -- step 3: Producir; bitmap OR native SVG
    | format        -- step 4: Estructurar (trazado, estructurado, borrador)
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- One cell of the grid view, bound to a Row.
entity PictogramCell {
    row: Row
    hovered: Boolean

    -- The most downstream available artifact (grid only).
    displayed_stage:
        if row.structured_svg != null: estructurado
        else if row.raw_svg != null: trazado
        else if row.bitmap != null: bitmap
        else: none
}

-- The maximised view of one step of one row.
entity FocusView {
    row: Row
    step: FocusStep
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- === View mode ===

rule SelectViewMode {
    when: ViewModeSelected(settings, mode)
    ensures: settings.view_mode = mode

    @guidance
        -- Re-renders the same rows in the chosen layout; ordering is kept.
        -- The choice is written to the library config, so reopening the
        -- library or reloading the app restores it. A missing value means
        -- list.
}

rule NewRowShowsList {
    when: RowAddedFromSearch(settings, row)
    ensures: settings.view_mode = list

    @guidance
        -- Adding a row from the header search switches to list so the new
        -- row is visible, open, and starts its cascade when it has text.
}

-- === Grid cell ===

rule HoverCell {
    when: CellHovered(cell)
    requires: cell.displayed_stage != none
    ensures: cell.hovered = true

    @guidance
        -- Shows the stage pill (bitmap | trazado | estructurado, existing
        -- i18n terms) and an action strip: trace (bitmap stage only, opens
        -- the VTracer modal), edit (trazado or estructurado, opens
        -- SVGEditorModal on that artifact) and download of the displayed
        -- artifact (.png or .svg). With no image there is no overlay; the
        -- large Play button is the only affordance.
}

rule ClickPictogram {
    when: CellPictogramClicked(cell)
    requires: cell.displayed_stage != none
    ensures: FocusView.created(
        row: cell.row,
        step: if cell.displayed_stage = bitmap: producir else: format
    )

    @guidance
        -- The pictogram opens the step that owns the displayed artifact.
        -- (Changed: it used to open nlu.) Enter or Space on the focused
        -- pictogram does the same.
}

rule ClickBadge {
    when: CellBadgeClicked(cell, step)
    requires: step in {nlu, visual, producir}
    ensures: FocusView.created(row: cell.row, step: step)

    @guidance
        -- Three badges, numbered 1-3, coloured by the step status, with
        -- the failure cause in the tooltip.
}

rule ClickPlay {
    when: CellPlayClicked(cell)
    requires: not cell.row.is_processing
    ensures: CascadeRequested(row: cell.row)

    @guidance
        -- Both the large placeholder Play (no image) and the small footer
        -- Play trigger the cascade; no modal opens. While the row is
        -- processing the footer button is Stop.
}

rule EditUtteranceInCell {
    when: CellUtteranceEdited(cell, text)
    ensures: cell.row.utterance = text

    @guidance
        -- Inline edit with the row view's semantics: steps 1-3 become
        -- outdated; commit on blur or Enter, Escape leaves the editor.
        -- Committing settles the intervention recorder. No modal opens.
        -- Clicks elsewhere on the cell do nothing.
}

-- === Focus view ===

rule FocusStepChanged {
    when: FocusStepSelected(view, step)
    ensures: view.step = step
}

rule ProducirStructureShortcut {
    when: ProducirStructureClicked(view)
    requires: view.step = producir
    requires: view.row.bitmap != null
    requires: not view.row.is_vector_model
    ensures: view.step = format

    @guidance
        -- A bitmap row shows "Estructurar" under the image, which moves to
        -- the format step; structuring actions live there, as in the row
        -- list.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant RetraceRequiresBitmap {
    -- The trace / retrace action (VTracer modal) is offered only for rows
    -- with a bitmap. Vector model rows have no bitmap to trace.
    for cell in PictogramCells:
        cell.displayed_stage = bitmap implies cell.row.bitmap != null
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface LibraryViewSwitcher {
    facing user: LibraryConfig
    context settings: LibraryConfig

    exposes:
        settings.view_mode

    provides:
        ViewModeSelected(settings, mode)

    @guarantee SortAppliesToBothViews
        -- Both views show the same rows in the same order: alphabetical by
        -- utterance, filtered by the header search text. There is no
        -- user-facing sort control (the planned alphabetical /
        -- completeness buttons were never built).

    @guarantee DefaultViewIsList
        -- A library with no stored mode opens in list: the row layout
        -- makes the pipeline state and per-row controls legible on first
        -- encounter.

    @guidance
        -- Right end of the library toolbar, after the Pictogramas /
        -- Secuencias / Tableros tabs; list first, grid second (lucide List,
        -- LayoutGrid), active one highlighted and aria-pressed. Shown only
        -- in pictogramas mode with at least one row. When it scrolls under
        -- the sticky header a floating copy appears at the right edge.
}

surface RowListView {
    facing user: LibraryConfig
    context row: Row

    exposes:
        row.utterance
        row.bitmap
        row.raw_svg
        row.structured_svg
        row.structured_svg_draft

    @guarantee ExpandedRowLayout
        -- An expanded row fits the viewport below the sticky header without
        -- page scroll; each column takes the full interior height and
        -- scrolls on its own. On narrow viewports the columns stack, each
        -- slot snaps into view.

    @guarantee RowArtifactStacking
        -- The produce column stacks the available artifacts in pipeline
        -- order: bitmap, trazado, estructurado (and borrador). Every slot
        -- offers download; SVG slots add edit; the trazado slot adds
        -- retrace only when the row has a bitmap; Phase 3 regeneration is
        -- the column-level button, not a bitmap-slot action.

    @guarantee StructuringViewIsTheSameEverywhere
        -- The row list and the focus view render artifacts, actions and
        -- notices from one component (SVGGenerator); only the layout
        -- differs (stacked here, columns in the focus view). While
        -- structuring runs a progress panel takes the result slot. Below
        -- the action row there is at most one short line: why a borrador
        -- is not certified, or why structuring is pending. The Phase 4
        -- model is chosen in the library settings, not per row.
}

surface PictogramGridCell {
    facing user: LibraryConfig
    context cell: PictogramCell

    exposes:
        cell.displayed_stage
        cell.row.utterance
        cell.hovered

    provides:
        CellHovered(cell)
        CellPictogramClicked(cell) when cell.displayed_stage != none
        CellBadgeClicked(cell, step)
        CellPlayClicked(cell)
        CellUtteranceEdited(cell, text)

    @guarantee StageLabelOnHover
        -- The stage pill is visible only on hover and names every
        -- displayed stage, bitmap included. (Changed: the bitmap used to
        -- carry no label; grid cells now fall back to it on most rows.)

    @guidance
        -- Vertical card: square pictogram area (non-square images
        -- letterboxed) showing displayed_stage, or a large Play when none;
        -- footer with the sentence-cased utterance, Play/Stop and badges
        -- 1-3. Columns: 2 below 640 px, 3 below 1024 px, 4 below 1280 px,
        -- 5 above. Hover actions are reachable by Tab in visual order.
}

surface ProducirFocusStep {
    facing user: LibraryConfig
    context view: FocusView where step = producir

    exposes:
        view.row.bitmap when not view.row.is_vector_model
        view.row.raw_svg when view.row.is_vector_model

    provides:
        ProducirStructureClicked(view) when view.row.bitmap != null
        FocusStepSelected(view, step)

    @guarantee Phase3ArtifactStaysInProducirStep
        -- This step shows only the Phase 3 artifact: the bitmap for a
        -- bitmap model, the native SVG for a vector model. A trace of the
        -- bitmap never appears here; it belongs to the format step.

    @guidance
        -- Vector rows: edit (SVGEditorModal on the raw SVG) and an SVG
        -- download. Bitmap rows: "Estructurar". Footer: regenerate (Stop
        -- while running) and copy, which copies the prompt. "Limpiar
        -- estilos en línea" is not offered here; only inside the editor.
}

surface FormatFocusStep {
    facing user: LibraryConfig
    context view: FocusView where step = format

    exposes:
        view.row.raw_svg
        view.row.structured_svg
        view.row.structured_svg_draft
        view.row.bitmap

    provides:
        FocusStepSelected(view, step)

    @guarantee FormatStepRendering
        -- Same SVGGenerator view as the row list, in columns. Tiles, left
        -- to right: trazado (or the bitmap as source, no actions),
        -- estructurado, borrador, and an empty slot beside a lone trazado.
        -- Each artifact tile carries edit, download and delete (delete
        -- asks first; trazado and estructurado are flagged discarded, the
        -- borrador is cleared). One action row: with an estructurado,
        -- restructure (when a trazado exists) + retrace; with a trazado
        -- only, "Estructurar trazado" (primary) + "Estructurar desde el
        -- bitmap" + retrace; with a bitmap only, "Estructurar" (primary) +
        -- "Solo trazar". Retrace only when the row has a bitmap. The
        -- footer downloads the most downstream SVG.

    @guarantee FormatStepEmpty
        -- With no trazado, estructurado, borrador or bitmap, a single
        -- notice replaces the tiles. The earlier gated design (right
        -- column disabled until a trace exists) is superseded.

    @guidance
        -- "Limpiar estilos en línea" is not present; only inside the
        -- editor. 50/50 split on wide viewports, stacked on narrow ones.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- Resolved: default view is list; the mode persists in the library config
-- Superseded: sort buttons were never built; rows are alphabetical
-- Superseded: pictogram click opened nlu; it now opens producir or format
-- Superseded: format right column disabled until a trace exists
-- Superseded: bitmap carries no stage label
-- Resolved: retrace requires a bitmap; never on vector model rows
-- Resolved: "Limpiar estilos en línea" lives only in SVGEditorModal

open question "The format-step empty notice still reads 'El estructurado se genera a partir del trazado. Vectoriza primero.' (library.structureRequiresRaw), but it now shows only when the row has no image at all. Should it point at Producir?"

open question "Hover overlay on touch devices: tap-to-reveal, or actions only through the focus modal?"

open question "Keyboard navigation across grid cells (arrow keys) for accessibility parity."

open question "Bitmap editing with an external tool: download-and-open or round-trip; this spec or a tool-integration spec?"
