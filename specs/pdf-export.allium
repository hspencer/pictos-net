-- allium: 3
-- pdf-export.allium

-- Scope: The printable PDF of the open Library ("Descargar imprimibles"): a
--   multi-page card sheet meant to be printed and cut into cards for AAC use
--   in clinical, educational and family settings. The same engine serves
--   the sequence printout (sequences.allium) through two optional inputs.
-- Includes:
--   - The library-menu item, its enabled and disabled states
--   - Page composition: Letter portrait, 2 columns, header and footer
--   - Cell composition: pictogram on top, full utterance below, a cut guide
--     around the whole cell, an optional per-cell badge
--   - Artifact selection (estructurado > trazado > bitmap) and rasterisation
--   - A blocking progress modal with cancel
--   - Optional inputs: title override and per-cell badge
-- Excludes:
--   - Cover page or table of contents (each page carries a header)
--   - Page size or orientation selector (fixed at Letter portrait)
--   - Per-row metadata pages (NLU, elements, prompt)
--   - Print-shop controls (bleed, registration marks, CMYK)
--   - Re-running any pipeline phase to fill missing pictograms
-- Dependencies:
--   - Row (visual-reasoning.allium); library-views.allium for ordering and
--     artifact priority
--   - GlobalConfig: name, credits, license, UI language

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- A pictogram row. The export reads its artifacts and utterance only.
external entity Row {
    utterance: String
    has_valid_artifact: Boolean     -- a non-discarded structured SVG, raw SVG or bitmap
    artifact_source: ArtifactSource
}

-- The open library's configuration, read for page furniture.
external entity LibraryConfig {
    name: String
    credits: String?
    license: String?
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum ArtifactSource {
    estructurado    -- structured SVG, rasterised to PNG
    | trazado       -- raw SVG, rasterised to PNG
    | bitmap        -- raster from Producir, embedded as is
    | none          -- no artifact; the row is skipped
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- One run of the export. Lives only while in flight; no persistence.
entity PdfExport {
    library: LibraryConfig
    title_override: String?         -- the sequence export passes the sequence name
    has_badges: Boolean             -- the sequence export passes step numbers
    total_cells: Integer
    rendered_cells: Integer
    total_pages: Integer
    current_page: Integer
    current_utterance: String?
    status: preparing | rendering | complete | cancelled | failed

    transitions status {
        preparing -> rendering
        preparing -> cancelled
        preparing -> failed
        rendering -> complete
        rendering -> cancelled
        rendering -> failed
        terminal: complete, cancelled, failed
    }
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    page_width_mm: Decimal = 215.9          -- Letter portrait
    page_height_mm: Decimal = 279.4
    margin_mm: Decimal = 15
    column_gutter_mm: Decimal = 8
    row_gutter_mm: Decimal = 10
    columns: Integer = 2
    target_dpi: Integer = 300
    cut_guide_stroke_mm: Decimal = 0.2
    utterance_font_pt: Integer = 13
    header_font_pt: Integer = 10
    footer_font_pt: Integer = 9
    filename_name_max_length: Integer = 30
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule TriggerExport {
    when: PrintablesRequested(library, eligible_count)
    requires: eligible_count > 0
    requires: not exists PdfExport{library: library}
    ensures: PdfExport.created(
        library: library,
        title_override: null,
        has_badges: false,
        total_cells: eligible_count,
        rendered_cells: 0,
        total_pages: 0,
        current_page: 0,
        current_utterance: null,
        status: preparing
    )

    @guidance
        -- The library menu closes and the progress modal opens. The
        -- sequence printout calls the same engine directly, without the
        -- modal (sequences.allium ExportSequencePdf).
}

rule PrepareExport {
    when: export: PdfExport.created
    requires: export.status = preparing
    ensures: export.status = rendering

    @guidance
        -- Rows without a valid artifact are dropped (OnlyGeneratedRows).
        -- Cell heights are measured first (utterance wrap depends on the
        -- embedded font), rows of two cells are paginated so a row never
        -- splits across pages, and total_pages is known before drawing.
        -- Rows are taken in the order passed by the caller; for the library
        -- that is the stored row order (see open questions).
}

rule RenderCell {
    when: CellRendered(export, utterance)
    requires: export.status = rendering
    ensures: export.rendered_cells = export.rendered_cells + 1
    ensures: export.current_utterance = utterance

    @guidance
        -- See PdfLayout. Each cell uses the most downstream valid artifact;
        -- SVGs are rasterised on white at target_dpi for the printed width,
        -- bitmaps are embedded directly.
}

rule CompleteExport {
    when: export: PdfExport.rendered_cells
    requires: export.status = rendering
    requires: export.rendered_cells = export.total_cells
    ensures: export.status = complete
    ensures: PdfDownloaded(
        export: export,
        filename: sanitize(export.library.name, config.filename_name_max_length) + "_pictos_" + date_stamp(now) + ".pdf"
    )

    @guidance
        -- "pictonet" when the sanitised name is empty. Log: "PDF exportado
        -- (N pictogramas, M páginas)". The modal closes.
}

rule CancelExport {
    when: CancelPdfExportRequested(export)
    requires: export.status in {preparing, rendering}
    ensures: export.status = cancelled

    @guidance
        -- No file is downloaded; the partial work is discarded; an info
        -- entry is logged; the modal closes. Cancellation is a first-class
        -- outcome, not an error.
}

rule FailExport {
    when: PdfExportErrored(export, error)
    requires: export.status in {preparing, rendering}
    ensures: export.status = failed

    @guidance
        -- No file; an error entry with the message is logged; the modal
        -- closes.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant SinglePdfExportAtATime {
    for a in PdfExports:
        for b in PdfExports:
            (a != b and a.library = b.library)
                implies (a.status in {complete, cancelled, failed} or b.status in {complete, cancelled, failed})
}

invariant ProgressIsBounded {
    for export in PdfExports:
        export.rendered_cells >= 0 and export.rendered_cells <= export.total_cells
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface LibraryMenuPrintables {
    facing user: LibraryConfig
    context library: LibraryConfig

    provides:
        PrintablesRequested(library, eligible_count)

    @guidance
        -- "Descargar imprimibles" (lucide FileText) in the library menu,
        -- after Exportar librería (.json) and Exportar frases (.txt) and
        -- before "Descargar pictogramas (N)". No count in the label.
        -- Disabled (40% opacity, not-allowed cursor) when no row has a
        -- valid artifact or an export is in flight.
}

surface PdfExportProgressModal {
    facing user: LibraryConfig
    context export: PdfExport

    exposes:
        export.status
        export.total_cells
        export.rendered_cells
        export.current_page
        export.total_pages
        export.current_utterance

    provides:
        CancelPdfExportRequested(export)

    @guarantee BlocksTheLibrary
        -- The modal blocks the Library while it runs, so the snapshot taken
        -- at the start is not edited mid-export. It closes only on
        -- complete, cancelled or failed; it never times out.

    @guidance
        -- Title "Generando PDF…", progress bar rendered / total, caption
        -- "Página X de Y" (or "preparing") and "Pictograma N de M:
        -- {utterance}", and a Cancel button.
}

surface PdfLayout {
    facing reader: LibraryConfig
    context export: PdfExport

    @guarantee OnlyGeneratedRows
        -- A row enters the PDF iff it has a valid (non-discarded)
        -- artifact; empty rows would leave holes and waste paper.

    @guarantee ArtifactPriorityMatchesGridView
        -- Each cell uses the most downstream artifact, as the grid does:
        -- estructurado > trazado > bitmap.

    @guarantee UtteranceNeverTruncated
        -- The utterance wraps to as many lines as needed; the cell grows,
        -- and the two cells of a row share the taller height. The shorter
        -- cell's spare space sits below its text.

    @guarantee CutGuideOnEveryCell
        -- A single hairline rectangle (cut_guide_stroke_mm, about 60% grey)
        -- frames each whole cell, pictogram and utterance together, so the
        -- sheet can be cut into cards. (Changed: it used to frame the
        -- pictogram only.)

    @guarantee FixedLetterPortrait
        -- One page size and orientation; no hidden switches.

    @guidance
        -- Page: Letter portrait, margin_mm on all sides, two columns of
        -- about 89 mm with column_gutter_mm between, row_gutter_mm between
        -- rows. Header on every page: the library name, or the title
        -- override, on the left and "Página N de M" on the right, in
        -- capitals, header_font_pt, over a thin rule. Footer: credits left,
        -- license right, footer_font_pt, capitals; omitted when both are
        -- empty. Pictogram slot: column width minus padding, with the same
        -- height for every cell, from the library's legacy aspect ratio
        -- (1:1 in practice); per-row native aspect ratio was never built.
        -- Utterance: Lexend (embedded) at utterance_font_pt, line height
        -- 1.25, centred. Badge (sequence export only): small grey number on
        -- a faint white chip, top-left over the pictogram, outside the
        -- caption space.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- Resolved: Letter portrait, 2 columns, header per page, optional footer
-- Resolved: artifact priority mirrors the grid; SVG rasterised, bitmap embedded as is
-- Resolved: blocking progress modal with cancel
-- Resolved: font is Lexend, embedded
-- Resolved: menu label "Descargar imprimibles", without count
-- Superseded: cut guide around the pictogram only
-- Superseded: pictogram drawn in each row's native aspect ratio (rows carry none)

open question "Order: the spec says the sheet follows the on-screen order (alphabetical), but the library export passes rows in stored order. Pass the displayed order?"

open question "Non-square bitmaps are drawn into the square slot without letterboxing and would be stretched. Fit them instead?"

open question "Tagged, accessible PDF (alt text from the utterance) for a v2."

open question "Estimated time remaining in the modal, or count-based progress only?"
