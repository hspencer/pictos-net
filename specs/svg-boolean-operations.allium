-- allium: 3
-- svg-boolean-operations.allium

-- Scope: Boolean path operations (union, subtract, intersect) over the
--   current selection in the SVG editor. Intended primarily for
--   post-vectorization cleanup: merging fragments that should be a single
--   semantic shape, and correcting vectorization artefacts (stray dark-grey
--   borders around black strokes, small white discs that should be
--   subtracted from a larger disc to form a hole, etc.).
-- Includes: Operand eligibility, operand ordering, identity of the result,
--   placement in the semantic tree, style survival, empty-result handling,
--   history, and Simplify (curve refit of selected paths), which shares the
--   toolbar block and the commit path.
-- Not built (deferred): group operands, keyboard shortcuts, the top/base
--   marker for two shapes, and user-visible rejection messages (rejections
--   are only logged; a disabled button's tooltip carries the eligibility
--   reason).
-- Excludes:
--   - Multi-selection mechanics: the unified selection model is owned by
--     vector-editor.allium. This spec only consumes the current selection.
--   - The polygon/Bezier clipping algorithm (library-provided black box)
--   - Undo/redo machinery (inherited from the editor's history, see
--     vector-editor.allium CommitAndHistory)
--   - Vectorization itself (VTracer, a separate user-initiated action outside
--     the cascade; the editor is not coupled to it)
-- Dependencies: vector-editor.allium (unified Selection and the single commit
--   path), pictos-svg-schema semantic tree, two-level CSS model (see
--   docs/CSS_STYLING_ARCHITECTURE.md).

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- Abstract closed region(s) on the canvas, in the coordinate space of the
-- shape's parent.
external entity Geometry {}

-- An SVG element that can take part in a boolean operation.
external entity Shape {
    id: String
    classes: Set<String>
    kind: ShapeKind
    parent: Shape?                  -- semantic parent in the SVG tree
    z_index: Integer                -- document order among siblings
    depth: Integer                  -- distance from the SVG root
    geometry: Geometry?             -- absent when it cannot be computed
    has_non_geometric_descendants: Boolean   -- text, image, foreignObject
}

-- The unified selection, owned by vector-editor.allium. One ordered set in
-- user selection order; `shapes` is that set as this spec sees it (each member
-- is a selectable Shape). The first member is the selection's base/primary for
-- operand ordering. This spec reads it and never maintains a second selection
-- field of its own.
external entity Selection {
    shapes: List<Shape>
}

-- The hosting editor. Holds the document, selection, history and the
-- library-class citation registry (citeClass/unciteClass).
external entity SVGEditor {
    selection: Selection
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract BooleanOperationBoundary {
    combine: (op: BooleanOp, operands: List<Shape>) -> Geometry

    @invariant GroupsAreNotOperands
        -- Only <path> and primitives (rect, circle, ellipse, polygon,
        -- polyline) are eligible operands; a group in the selection makes the
        -- operation ineligible (unsupported element). Deferred design: a
        -- group would count as the union of its descendants' geometries and
        -- keep its id and classes; one with non-geometric descendants would
        -- stay ineligible.

    @invariant GeometryIsCommutativeExceptSubtract
        -- For union and intersect, operand order does not change the
        -- resulting shape; order still decides identity (the first selected
        -- shape is the base). Subtract follows the Inkscape/Illustrator
        -- convention: the shape drawn on top (higher z_index) is removed
        -- from the shape below, which is the base.

    @invariant BaseIdentitySurvives
        -- The result is always a <path> that keeps the base's id, classes,
        -- local CSS overrides (#id rules follow the id) and any inline fill,
        -- stroke, stroke-width and opacity the base carried (raw traces have
        -- inline fills). Other operands' classes and overrides are discarded,
        -- subject to library-class garbage collection. Union and subtract
        -- results take the even-odd fill rule, as attribute and inline style,
        -- so holes render whatever the winding order: a deliberate exception
        -- to the zero-inline-attributes convention.

    @invariant TransformsBaked
        -- Every operand's transforms, and its ancestors' up to the SVG root,
        -- are baked into its path data before the boolean is computed, so the
        -- result is in root space and carries no transform. It is placed in
        -- the deepest common ancestor only when neither that ancestor nor any
        -- ancestor above it is transformed; otherwise it goes to the root.

    @invariant SemanticGuardApplies
        -- The result is committed through the editor's single commit path, so
        -- on a structured SVG with bindings the semantic guard refuses an
        -- operation that would add a binding violation (for example operands
        -- in two bound groups, whose result would land outside them). The
        -- document and selection are then unchanged.

    @invariant NoSemanticRecovery
        -- An applied operation is reversed only by undo. Original operands
        -- are not kept as hidden sources (unlike Figma's non-destructive
        -- boolean groups).

    @invariant IdUniqueness
        -- The surviving id remains unique because every other operand, with
        -- its id, is removed.

    @invariant GeometryLocality
        -- Path geometry never leaves the browser; the clipping library runs
        -- locally.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum BooleanOp { union | subtract | intersect }

enum ShapeKind {
    path            -- <path>
    | primitive     -- <rect>, <circle>, <ellipse>, <polygon>, <polyline>
    | group         -- <g> with geometric descendants
}

enum RejectionReason {
    insufficient_operands
    | unsupported_element
    | degenerate_geometry
    | empty_result
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Eligibility: union and intersect need at least two operands, subtract
-- exactly two (to subtract a union, the user unions first); every operand
-- needs computable geometry and no non-geometric descendants.

rule ApplyBooleanOperation {
    when: BooleanOperationRequested(editor, op)
    let operands = editor.selection.shapes
    requires: eligible(op, operands)
    let base = base_of(op, operands)
    let result = editor_combine(op, operands)
    requires: not is_empty(result)
    ensures: base.geometry = result
    ensures: base.parent = result_parent(operands)
    ensures:
        for operand in operands:
            if operand != base:
                not exists operand
    ensures: LibraryClassesReleased(editor: editor, removed: operands)
    ensures: HistoryStepRecorded(editor: editor, operation: op)
    ensures: SelectionReplaced(editor: editor, shape: base)

    @guidance
        -- base_of: for union and intersect the first shape in selection
        -- order; for subtract the operand with the lower z_index (the one
        -- that is bitten). editor_combine computes union (overlaps merge,
        -- internal edges disappear), base minus top for subtract, or the
        -- intersection. result_parent is the deepest common ancestor, or the
        -- SVG root when that ancestor or one above it is transformed. The
        -- result takes the base's z_index there (or that of the base's
        -- ancestor under it). With operands in disjoint top-level groups the
        -- ancestor is the SVG root, an acceptable loss of nesting for cleanup
        -- on an unbound trace (refused by the guard on a bound document).
        -- Groups left empty are removed. Classes cited only by removed
        -- operands lose a citation; library rules left with none are
        -- collected by the existing unciteClass mechanism. The history step
        -- is atomic: one undo restores every operand at its position with its
        -- id, classes, local overrides and subtree. The selection becomes the
        -- result alone, so operations can be chained.
}

rule RejectIneligibleSelection {
    when: BooleanOperationRequested(editor, op)
    requires: not eligible(op, editor.selection.shapes)
    ensures: BooleanOperationRejected(
        editor: editor,
        reason: ineligibility_reason(op, editor.selection.shapes)
    )

    @guidance
        -- The document is unchanged. Intended: the user is told why
        -- (insufficient operands, unsupported element type, or degenerate
        -- geometry). Built so far: buttons follow eligibility and a disabled
        -- button's tooltip names the reason; a rejected request is only
        -- logged.
}

rule RejectEmptyResult {
    when: BooleanOperationRequested(editor, op)
    requires: eligible(op, editor.selection.shapes)
    requires: is_empty(editor_combine(op, editor.selection.shapes))
    ensures: BooleanOperationRejected(editor: editor, reason: empty_result)

    @guidance
        -- Examples: the intersection of disjoint shapes; a subtraction whose
        -- top shape covers the bottom one. In cleanup this almost always
        -- means a user error, so the operands are kept rather than deleted
        -- silently. The reason is only logged today (see RejectIneligibleSelection).
}

rule SimplifySelectedPaths {
    when: SimplifyRequested(editor)
    requires: editor.selection.shapes.any(s => s.kind = path)
    ensures:
        for shape in editor.selection.shapes:
            if shape.kind = path:
                shape.geometry = refit_curves(shape.geometry)
    ensures: HistoryStepRecorded(editor: editor, operation: simplify)

    @guidance
        -- Refits polyline noise to Bezier curves (tolerance 0.5) in place;
        -- non-path members are skipped; a path whose refit fails is kept.
        -- With nothing to refit the request is rejected without change. In
        -- node-edit mode the edited path counts as the selection. Shown as a
        -- toolbar button whenever the selection holds a path.
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface BooleanOperationControls {
    facing editor: SVGEditor

    exposes:
        editor.selection.shapes

    provides:
        BooleanOperationRequested(editor, op)
            when eligible(op, editor.selection.shapes)

    @guarantee ButtonsFollowEligibility
        -- Each button is hidden, not just disabled, when the selection does
        -- not meet its eligibility: union and intersect show from two
        -- selected shapes, subtract with exactly two. A button that is
        -- visible but blocked by a secondary condition (a group with
        -- non-geometric children) is disabled with a tooltip saying why.

    @guidance
        -- Host: the buttons live in SelectionToolbar (the floating toolbar
        -- above the canvas while shapes are selected), not in the side
        -- properties panel, which is for one shape's attributes. Order:
        -- [Group] [Ungroup] | [Union] [Subtract] [Intersect] | [Simplify] |
        -- [Duplicate] [BringForward] [SendBackward] | [ApplyClass] | [Delete],
        -- with dividers around the boolean block, next to Group/Ungroup
        -- because both combine operands. Icons follow Inkscape/Figma: two
        -- filled overlapping discs (union), a disc with a disc-shaped bite
        -- (subtract), a lens (intersect). The user reorders the two subtract
        -- operands with BringForward/SendBackward.
        -- Deferred, not built: marking which of two shapes is on top (it
        -- bites) and which is the base; keyboard shortcuts (Inkscape's
        -- Cmd/Ctrl + Plus/Minus would collide with the editor's zoom
        -- shortcuts); a spinner or Web Worker for operations over 100 ms.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Which keyboard shortcuts should trigger boolean operations, given that Cmd/Ctrl + Plus/Minus already zoom the editor?"

open question "Should a group operand with non-geometric descendants (text, image, foreignObject) disqualify the whole operation, or silently skip those descendants?"

open question "When a group is an operand and one of its descendants has user-authored local overrides, those overrides are lost in the collapse. Should the editor warn the user before proceeding?"

open question "For very complex paths (10k+ segments), should the operation run in a Web Worker with a cancellable progress UI?"

open question "Should subtract support more than two operands as a convenience (implicitly: 'A minus union(B, C, ...)')? Adds UI ambiguity about which operand is the Base."
