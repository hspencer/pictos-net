-- allium: 3
-- Phase 5 and the portable mf-svg artifact boundary.
-- This specifies the 2.0.0-draft.1 candidate, not a published release.
-- Existing 1.0 documents remain historical inputs under their frozen contract.
-- Implementation gates below must be verified; this file alone does not prove
-- conformance, cognitive accessibility, publication, or training readiness.

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity Editor {
    id: String
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value StructuringInput {
    raw_svg: String
    nlu: Any
    composition: Any
    known_provenance: Any
    explicit_bindings: List<SemanticBinding>
}

value SemanticBinding {
    composition_element_id: String?
    kind: BindingKind
    label: String
    svg_group_id: String?
    performed_by: String?
}

value SvgConformance {
    profile_version: String
    content_hash: String
    valid: Boolean
    issues: List<String>
}

value RevisionReference {
    profile_version: String
    content_hash: String
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract LocalGeometryAssembly {
    assemble: (input: StructuringInput, mapping: Any) -> String

    @invariant CoherentAssemblyInput
        -- Assembly receives a frozen raw SVG, the exact supplied NLU and
        -- composition including any supplied prompt, and actually known
        -- provenance. Semantic completeness is required for certification,
        -- not draft admission. Assembly cannot reconstruct absent semantics or
        -- execution history from current settings, labels, or a provider name.

    @invariant MappingIsNotGeometry
        -- The regrouping model proposes source path ids and semantic groups.
        -- It does not author replacement geometry. Original geometry remains
        -- local; effective ancestor transforms, fill, fill-rule, stroke and
        -- opacity survive re-parenting. fill="none" never becomes solid fill.
        -- Redraw, where explicitly selected, is a distinct geometric revision
        -- and must not claim exact preservation of the original geometry.

    @invariant GeometryAndStylePreservation
        -- Existing unique ids and user style classes are preserved where
        -- possible. Collision-free ids are assigned where missing. Id changes
        -- update every local reference, including metadata and CSS references.
        -- User styles override library defaults. Automatic classes cannot
        -- recolour a path contrary to its observed fill role. Necessary defs,
        -- focus styles and referenced keyframes survive style filtering.
        -- Non-path primitives cannot be silently dropped: preserve them or
        -- return a diagnostic draft that cannot claim geometry completeness.

    @invariant EverySourcePathAccountedFor
        -- Every source path is retained exactly once, included in an explicitly
        -- gated merge, or recorded as deliberately discarded by the editor.
        -- Missing assignments retain geometry in a diagnostic fallback group.
        -- A fallback name such as contexto is not evidence that the paths
        -- actually depict a semantic context. Duplicate or unknown assignments
        -- are diagnostics, not permission to duplicate or invent geometry.

    @invariant LocallyGatedMerges
        -- The model only proposes merges. Local geometric compatibility checks
        -- determine whether they are safe; rejected proposals keep original
        -- separate paths. Even-odd holes must survive. A merge-free candidate
        -- is preferred when it preserves more original ink. Fidelity warnings
        -- remain visible and do not destroy or withhold the editable draft.
        -- Structural conformance is not a claim of measured visual fidelity.
        -- If an ink comparison exceeds config.fidelity_warning_ratio of the
        -- original inked area, report added/removed coverage and compare the
        -- merge-free candidate. This existing warning policy is non-blocking.

    @invariant ParseFailureIsNotSemanticRepair
        -- Empty, non-string, malformed or empty-group assignments fail with
        -- diagnostics. No inferred group, performer or semantic label repairs
        -- an invalid response into accepted meaning. Raw responses retained
        -- for diagnosis remain unvalidated and are not embedded as reasoning.
}

contract GeometricEditingBoundary {
    can_trace: (bitmap_available: Boolean) -> Boolean
    can_edit_trace: (trace_available: Boolean) -> Boolean

    @invariant SemanticsDoNotBlockGeometry
        -- Tracing requires only a usable bitmap. An existing trace remains
        -- visible, editable and downloadable even when NLU or composition
        -- fails current semantic validation. Retracing stays available while
        -- its bitmap is available, in both compact and focused views.

    @invariant ExplainOnlyTheBlockedOperation
        -- Incomplete or historical semantics block canonical promotion, not
        -- draft structuring, TRAZAR or existing geometric artifacts. A localized
        -- diagnostic identifies COMPRENDER or COMPONER when their data requires
        -- review, with the affected fields. It never replaces the artifact
        -- workspace with a generic failure.
        -- A failed structuring attempt preserves trace access and retry controls.

    @invariant DraftAdmissionIsOperational
        -- A usable trace and a nonempty tree of uniquely identified visual
        -- elements suffice to propose and assemble a draft. Missing or historical
        -- NLU, incomplete vocabulary and prompt reference conventions are
        -- conformance diagnostics, not reasons to prevent visual grouping.
        -- Malformed geometry, ambiguous element ids, malformed assignments and
        -- active or external SVG content remain blocking errors.

    @invariant DraftIsNotCertification
        -- Preserve unassigned geometry without inventing a Context concept.
        -- Missing bindings and nonconforming semantic evidence leave a visible,
        -- editable, downloadable draft with localized review diagnostics.
        -- Preserve the exact supplied NLU and composition; do not synthesize
        -- missing values.
        -- A draft cannot acquire a canonical reference or replace an accepted
        -- revision. Late drafts cannot overwrite edits made during generation.
        -- Every user-facing failure is localized, including provider and final
        -- validation failures; technical details are not the default message.

    @invariant DraftEditorTargetsChosenArtifact
        -- A passive draft has its own edit and download actions in both compact
        -- and focused views. Editing opens that exact draft, never substitutes
        -- the raw trace or an accepted revision. Saving creates an uncertified
        -- draft snapshot and changes neither the raw trace nor the accepted
        -- revision or its reference. Editing alone never requests certification.
        -- If the draft or its source context changes after opening the editor,
        -- reject the stale save with a localized conflict diagnostic; retain
        -- the editor's unsaved content and the newer workspace artifacts.

    @invariant ResultExplainsCompletedStage
        -- Distinguish an attempt that failed before producing a usable draft
        -- from one that produced grouping but has not passed certification.
        -- A retained draft from an earlier attempt is not evidence that the
        -- latest attempt produced one. A new draft is labelled as generated
        -- and uncertified, with edit, download and retry controls; its result
        -- cannot be only a trace-ready instruction or a generic failure.
        -- When a specific blocking reason is known, retain and localize it,
        -- including affected fields or references where available. If a
        -- historical draft has no retained reason, explicitly say that the
        -- cause was not recorded; do not infer a semantic or provider failure.

    @invariant HistoricalValuesRemainEvidence
        -- Validation does not rewrite imported NLU or composition. Controls
        -- display the actual stored value even outside the current vocabulary,
        -- rather than appearing to select a permitted value that is not stored.
}

contract PortablePictogramRevision {
    validate: (content: String, profile_version: String) -> SvgConformance
    reference: (content: String, conformance: SvgConformance) -> RevisionReference

    @invariant OneRevisionOneTruth
        -- A conforming SVG is the portable source of truth for one pictogram
        -- revision: rendered geometry, full NLU, full composition, actual
        -- semantic bindings, accessibility text and known provenance travel
        -- together. A row is the editable workspace and history; any accepted
        -- reference identifies exact SVG bytes and the declared profile.
        -- Row caches are projections of that revision, not independently
        -- editable competing copies of its final semantic truth.

    @invariant CompleteVersionedPayloads
        -- Metadata contains the complete accepted NLU and complete composition
        -- documents, not lossy frames, invented NSM primes, or flattened tree
        -- summaries. Their versioned contract identities are explicit. The
        -- mf-svg product bundles matching canonical definitions for offline
        -- validation; the SVG need not embed copies of the schemas themselves.
        -- The utterance, language, title, descriptions and binding references
        -- must agree where they express the same fact. No fake default intent,
        -- speech act, generation model, source dataset, licence or timestamp
        -- fills a historical gap. A current assembly time is labelled as such.

    @invariant ClosedMetadataAndFailClosedValidation
        -- The 2.0 profile closes structural metadata objects. Any explicitly
        -- supported extension container is separate from normative fields and
        -- never overrides them. Well-formed XML alone is insufficient: metadata
        -- JSON, embedded contracts and cross-document references all validate.
        -- Unknown profiles, malformed JSON, duplicate JSON keys, unavailable
        -- validators or missing bundled schemas are failures, never warnings
        -- converted into conformance. Historical validation remains versioned;
        -- a readable 1.0 artifact is not silently relabelled 2.0.

    @invariant ActualBindingsOnly
        -- Explicit bindings identify an existing semantic SVG group. Present
        -- composition references resolve to actual composition element ids.
        -- Every semantic group has one unambiguous binding and a nonempty label;
        -- bindings cannot point to missing, duplicate or non-group ids. Sparse
        -- correspondence is allowed: a composition node without a rendered
        -- binding remains unresolved, never silently converted into an action.
        -- Unclassified fallback geometry cannot be labelled a known semantic
        -- concept just to pass conformance; retain it in a diagnostic draft.

    @invariant ImplicitMeaningIsRepresentable
        -- An action may be expressed by posture or relations with no separate
        -- drawn action group. A declared implicit binding has no own SVG
        -- group id. A supplied performedBy reference must resolve to a rendered
        -- explicit group. No performer is inferred solely from node order or
        -- guessed from the first Agent. Absence remains unknown; it does not
        -- require invention of an empty group or a decorative action symbol.

    @invariant AccessibleResolvableDocument
        -- SVG namespace and viewBox are valid. Document-wide ids are unique.
        -- The root exposes an image role and resolvable title/description ids;
        -- these texts and the document language are nonempty. Semantic groups
        -- expose group role and nonempty accessible labels. Every local href,
        -- URL reference, aria-labelledby and aria-describedby target exists.
        -- Accessibility annotations express descriptions, not proof of
        -- understanding, effectiveness or cognitive accessibility in users.

    @invariant SelfContainedPassiveArtifact
        -- A portable conforming SVG requires no remote image, font, stylesheet
        -- or script to render or interpret its normative content. Scripts,
        -- event handlers, external entities and executable foreign content are
        -- rejected. Local SVG references resolve within the same artifact.
        -- No validation step fetches remote schemas or referenced resources.

    @invariant KnownEvidenceAndPrivacy
        -- Embed only actually recorded, relevant provenance. API credentials,
        -- private chain-of-thought, raw provider diagnostics, participant
        -- identities, audio and the full interaction log are not automatically
        -- copied from the workspace into a portable artifact. Full historical
        -- NLU that contains sensitive data stays preserved in a local draft;
        -- publication needs an explicit privacy decision, never silent
        -- redaction disguised as the unchanged original accepted analysis.

    @invariant ReviewIsSeparateEvidence
        -- Technical conformance and a confirmed grouping screen never invent
        -- human semantic/cognitive approval. Unreviewed artifacts are permitted
        -- and labelled as such. Any actual review identifies its scope and the
        -- exact evaluated content; reviewer identity is included only under an
        -- approved disclosure policy. Editing geometry, meaning or descriptions
        -- produces a new revision and cannot inherit the old approval.

    @invariant FinalByteHashWithoutSelfReference
        -- The workspace reference is SHA-256 of exact final UTF-8 SVG bytes,
        -- computed only after id rewriting, geometry polish and final metadata
        -- serialization. That file hash is stored outside the hashed SVG,
        -- avoiding a circular self-hash. Known parent revision hashes and
        -- separately scoped input hashes may be embedded as provenance.
        -- No character, metadata field or style may change after hashing and
        -- still claim the same accepted reference.

    @invariant NoAutomaticPublicationOrTraining
        -- Producing or validating a local SVG does not publish it, license its
        -- contents, grant training eligibility, or certify human review.
        -- Public distribution and corpus inclusion require their own explicit
        -- approval and evidence under the publication and corpus contracts.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum BindingKind { explicit | implicit }
enum RevisionStatus { draft | conforming | rejected }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity StructuredRevision {
    content: String
    profile_version: String
    content_hash: String
    parent_hash: String?
    status: RevisionStatus
    conformance: SvgConformance?
    accepted_reference: RevisionReference?

    transitions status {
        draft -> conforming
        draft -> rejected
        terminal: conforming, rejected
    }
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    candidate_profile_version: String = "2.0.0-draft.1"
    fidelity_warning_ratio: Decimal = 0.05
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule CaptureStructuredDraft {
    when: StructuredDraftProduced(editor, content, parent_hash)
    requires: content != ""
    ensures:
        StructuredRevision.created(
            content: content,
            profile_version: config.candidate_profile_version,
            content_hash: sha256_utf8(content),
            parent_hash: parent_hash,
            status: draft,
            conformance: null,
            accepted_reference: null
        )
    @guidance
        -- Captures final assembly or an explicit edit. It is a new snapshot;
        -- a previous revision is never mutated or automatically reapproved.
}

rule AcceptConformingRevision {
    when: ConformanceEvaluated(revision, conformance)
    requires: revision.status = draft
    requires: conformance.content_hash = revision.content_hash
    requires: conformance.profile_version = revision.profile_version
    requires: conformance.valid
    requires: conformance.issues.count = 0
    ensures: revision.conformance = conformance
    ensures: revision.status = conforming
    ensures: revision.accepted_reference = {
        profile_version: revision.profile_version,
        content_hash: revision.content_hash
    }
}

rule RetainNonconformingDraft {
    when: ConformanceEvaluated(revision, conformance)
    requires: revision.status = draft
    requires: conformance.content_hash = revision.content_hash
    requires: conformance.profile_version = revision.profile_version
    requires: not conformance.valid
    requires: conformance.issues.count > 0
    ensures: revision.conformance = conformance
    ensures: revision.status = rejected
    @guidance
        -- Rejection means not conforming, not deleted. The exact draft remains
        -- editable and diagnosable. It cannot replace an accepted revision
        -- reference or be labelled a conforming portable artifact.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant RevisionHashIdentifiesExactBytes {
    for revision in StructuredRevisions:
        revision.content_hash = sha256_utf8(revision.content)
}

invariant AcceptedRevisionHasMatchingEvidence {
    for revision in StructuredRevisions:
        revision.status = conforming implies
            revision.conformance != null
            and revision.conformance.valid
            and revision.conformance.issues.count = 0
            and revision.conformance.content_hash = revision.content_hash
            and revision.conformance.profile_version = revision.profile_version
            and revision.accepted_reference != null
            and revision.accepted_reference.content_hash = revision.content_hash
            and revision.accepted_reference.profile_version = revision.profile_version
}

invariant UnverifiedRevisionHasNoAuthority {
    for revision in StructuredRevisions:
        revision.status in {draft, rejected} implies
            revision.accepted_reference = null
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor PictogramEditor {
    identified_by: Editor
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface StructuredArtifactBoundary {
    facing editor: PictogramEditor
    contracts:
        fulfils LocalGeometryAssembly
        fulfils GeometricEditingBoundary
        fulfils PortablePictogramRevision
    provides:
        StructuredDraftProduced(editor, content: String, parent_hash: String?)
        ConformanceEvaluated(revision: StructuredRevision, conformance: SvgConformance) when revision.status = draft
    @guarantee CompletionRequiresFinalValidation
        -- All generation routes, regrouping review, explicit redraw and editor
        -- saves pass the same final conformance boundary before accepting a
        -- new canonical reference. XML parsing and model success do not bypass
        -- it. Invalid results preserve the previous reference and the draft.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Which disclosed review evidence and cognitive evaluation criteria should the first public mf-svg profile support?"
open question "What explicit privacy and redaction workflow permits publication of a revision whose original NLU contains participant-identifying content?"
open question "How should unresolved composition nodes and retained unclassified geometry be reviewed before a draft becomes a public pictogram revision?"
