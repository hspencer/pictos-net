-- allium: 3
-- boards.allium

-- Scope: Communication boards (Tableros de comunicación) — fixed grids of
--   cells, each optionally linked to a Library Row and coloured by the
--   Fitzgerald key. Boards are the third content mode of a Library, beside
--   pictogramas and secuencias (sequences.allium).
-- Includes:
--   - Board and Cell entities; grid presets and custom sizes; resize
--   - Edit and use modes; use mode is a full-screen surface, never persisted
--   - Cell editor: Fitzgerald colour, row autocomplete (existing rows only),
--     audio recording
--   - Audio owned by the Row (one recording shared by every cell and board
--     that uses it)
--   - Board PDF in landscape Letter and Tabloid
--   - Portability through library download, backup, graph dump and templates
-- Excludes:
--   - Cross-board navigation (deferred)
--   - Pictogram generation from a board (existing rows only)
--   - TTS when a Row has no audio; audio trimming (open questions)
-- History (consolidated): board PDF export was first deferred and has since
--   shipped (Carta and Tabloide, landscape). Boards always open in edit
--   mode; use mode started as an in-page toggle and is now a full-screen
--   surface left with a control or Escape.
-- Storage (informative): boards live in localStorage under
--   pictonet_lib_{id}_boards. Audio is a base64 data URL on the Row (part of
--   the row metadata), so it travels with every row export.
-- Dependencies:
--   - Row (visual-reasoning.allium), Library (library-manager.allium)
--   - LibraryView, LibraryContentMode (sequences.allium)

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- A pictogram record. This spec adds the audio field.
external entity Row {
    library: Library
    utterance: String
    bitmap: String?
    raw_svg: String?
    structured_svg: String?
    audio: String?                  -- recorded clip as a data URL; null = none
}

external entity Library {
    name: String
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value GridDimensions {
    rows: Integer                   -- >= 1
    cols: Integer                   -- >= 1

    total_cells: rows * cols
}

value CellPosition {
    row_index: Integer              -- 0-based
    col_index: Integer              -- 0-based
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum FitzgeraldColor {
    amarillo        -- Personas / pronombres
    | verde         -- Verbos / acciones
    | azul          -- Adjetivos / descriptivos
    | naranja       -- Sustantivos / objetos
    | rosa          -- Palabras funcionales
    | morado        -- Expresiones sociales, saludos
    | gris          -- Sistema (default for new cells)
}

enum BoardMode {
    edit
    | use
}

enum PaperSize {
    letter          -- Carta, 279.4 x 215.9 mm landscape
    | tabloid       -- Tabloide, 431.8 x 279.4 mm landscape
}

enum RecordingState {
    idle
    | requesting
    | countdown
    | recording
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity Board {
    library: Library
    name: String
    grid: GridDimensions
    cells: Cell with board = this
    show_labels: Boolean            -- default true
    created_at: Timestamp
    modified_at: Timestamp

    assigned_cells: cells where row != null
}

entity Cell {
    board: Board
    position: CellPosition
    color: FitzgeraldColor
    row: Row?                       -- null = empty cell
}

-- Transient UI state of the open board; never persisted.
entity BoardSession {
    board: Board
    mode: BoardMode
    selected_cell: Cell?            -- the cell whose editor is open (edit mode)
    recording: RecordingState
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    countdown_seconds: Integer = 3
    autocomplete_limit: Integer = 8
    duplicate_suffix: String = " (copia)"
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- === Board lifecycle ===

rule CreateBoard {
    when: CreateBoardConfirmed(library, name, grid, show_labels)
    requires: name != ""
    requires: grid.rows >= 1 and grid.cols >= 1
    ensures:
        let board = Board.created(
            library: library,
            name: name,
            grid: grid,
            show_labels: show_labels,
            created_at: now,
            modified_at: now
        )
        for r in range(grid.rows):
            for c in range(grid.cols):
                Cell.created(board: board, position: CellPosition(row_index: r, col_index: c), color: gris, row: null)
        BoardOpened(board: board)

    @guidance
        -- "Crear nuevo tablero" opens a modal: name, preset buttons 2x2,
        -- 3x3, 4x4 (default), 4x6, 5x6, 6x6, 6x8, a "Personalizado" option
        -- with two positive-integer inputs, the resulting cell count, and
        -- the label toggle. The editor opens on the new board.
}

rule OpenBoard {
    when: BoardOpened(board)
    ensures: BoardSession.created(board: board, mode: edit, selected_cell: null, recording: idle)

    @guidance
        -- Always opens in edit mode; the mode is never persisted.
}

rule ConfigureBoard {
    when: BoardConfigured(board, name, grid, show_labels)
    requires: name != ""
    ensures: board.name = name
    ensures: board.show_labels = show_labels
    ensures: BoardResized(board: board, grid: grid)

    @guidance
        -- "Editar" in the card's "..." menu opens the same modal as
        -- creation, plus "Eliminar". The editor's gear button opens a
        -- smaller modal with rows and columns only.
}

rule ResizeBoard {
    when: BoardResized(board, grid)
    ensures: board.grid = grid
    ensures:
        for cell in board.cells:
            if cell.position.row_index >= grid.rows or cell.position.col_index >= grid.cols:
                not exists cell
    ensures: board.modified_at = now

    @guidance
        -- Cells inside the new bounds keep colour and row; every new
        -- position gets an empty gris cell (BoardHasExactCells).
}

rule ToggleLabels {
    when: LabelsToggled(board)
    ensures: board.show_labels = not board.show_labels
    ensures: board.modified_at = now
}

rule DuplicateBoard {
    when: DuplicateBoardRequested(board)
    ensures: BoardDuplicated(source: board, name: board.name + config.duplicate_suffix)

    @guidance
        -- Same library, grid, labels, colours and row references; fresh
        -- board and cell ids; created and modified now.
}

rule DeleteBoard {
    when: DeleteBoardConfirmed(board)
    ensures: not exists board

    @guidance
        -- "Eliminar" inside the Editar modal, after an inline confirmation
        -- ("¿Eliminar «{name}»? Esta acción no se puede deshacer.").
        -- Referenced Rows and their audio stay in the Library.
}

-- === Modes ===

rule EnterUseMode {
    when: UseModeRequested(session)
    requires: session.mode = edit
    ensures: session.mode = use
    ensures: session.selected_cell = null

    @guidance
        -- The board fills the viewport with every row and column fitted
        -- without scrolling; page scroll is locked; header and cell editor
        -- are hidden.
}

rule ExitUseMode {
    when: EditModeRequested(session)
    requires: session.mode = use
    ensures: session.mode = edit

    @guidance
        -- The upper-left exit control ("Salir de pantalla completa") or
        -- Escape; the pencil segment of the mode toggle in edit mode.
}

-- === Cell editing (edit mode) ===

rule SelectCell {
    when: CellTapped(session, cell)
    requires: session.mode = edit
    ensures:
        if session.selected_cell = cell:
            session.selected_cell = null
        else:
            session.selected_cell = cell

    @guidance
        -- Tapping a cell toggles its floating, draggable cell editor.
}

rule SetCellColor {
    when: CellColorSelected(cell, color)
    ensures: cell.color = color
    ensures: cell.board.modified_at = now
}

rule AssignRowToCell {
    when: CellRowSelected(cell, row)
    requires: row.library = cell.board.library
    ensures: cell.row = row
    ensures: cell.board.modified_at = now

    @guidance
        -- Autocomplete over the active Library's utterances (substring,
        -- case-insensitive, at most autocomplete_limit) with thumbnails.
        -- Only existing rows; no generation path from here.
}

rule ClearCellRow {
    when: CellRowCleared(cell)
    ensures: cell.row = null
    ensures: cell.board.modified_at = now

    @guidance
        -- The Row's audio is unaffected.
}

-- === Audio ===

rule StartRecording {
    when: RecordAudioRequested(session, cell)
    requires: cell.row != null
    requires: session.recording = idle
    ensures: session.recording = requesting

    @guidance
        -- "Agregar audio" when the Row has none, "Reemplazar audio" when it
        -- has one (no confirmation). Asks for microphone permission; denial
        -- shows an inline error and returns to idle. Once granted a
        -- countdown_seconds countdown (3, 2, 1) runs, then recording starts
        -- with a red pulsing indicator. Cancel is available during the
        -- countdown and the recording; it stores nothing.
}

rule StoreRecording {
    when: RecordingStopped(session, cell, clip)
    requires: session.recording = recording
    ensures: cell.row.audio = clip
    ensures: session.recording = idle

    @guidance
        -- The clip is stored on the Row as a data URL, recorded as MP4/AAC
        -- where the browser supports it, else WebM/Opus. When the Row is
        -- used by other cells or boards, a note says the audio applies to
        -- all of them.
}

rule ConvertAudioForIos {
    when: ConvertAudioRequested(board)
    ensures: BoardAudioConverted(board: board)

    @guidance
        -- Shown in the editor header when some linked Row holds non-MP4
        -- (legacy WebM) audio; converts each to MP4 so iOS can play it.
}

-- === Use mode ===

rule PlayCellAudio {
    when: CellTapped(session, cell)
    requires: session.mode = use
    requires: cell.row != null and cell.row.audio != null
    ensures: CellAudioPlayed(cell: cell)

    @guidance
        -- Any clip playing stops first; at most one plays at a time. A
        -- playback failure flashes the cell briefly. Cells without a row
        -- or audio are disabled and inert. Touch and click are deduplicated
        -- so one tap plays once.
}

-- === Export and portability ===

rule ExportBoardPdf {
    when: BoardPdfRequested(board, paper)
    ensures: BoardPdfDownloaded(board: board, paper: paper)

    @guidance
        -- One landscape page in the chosen size with the board name and
        -- the whole grid; each cell keeps its Fitzgerald colour and shows
        -- the best artifact (structured SVG > raw SVG > bitmap), with the
        -- utterance when show_labels. The filename names the board, paper
        -- size and date. A failure is only logged to the browser console
        -- (see open questions).
}

rule BoardsTravelWithLibrary {
    when: LibraryTransferred(source, target)
    ensures: BoardsRestored(library: target)

    @guidance
        -- Library download, backup, graph dump export and import, and
        -- template load all carry boards with the Rows (and audio) they
        -- reference. On arrival only the board's library changes; board
        -- ids, grids, colours and row references stay. A graph dump
        -- import replaces the active library's boards.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant BoardHasExactCells {
    for board in Boards:
        board.cells.count = board.grid.total_cells
}

invariant CellPositionsAreUnique {
    for a in Cells:
        for b in Cells:
            (a != b and a.board = b.board)
                implies not (a.position.row_index = b.position.row_index
                             and a.position.col_index = b.position.col_index)
}

invariant CellPositionWithinGrid {
    for cell in Cells:
        cell.position.row_index >= 0
        and cell.position.row_index < cell.board.grid.rows
        and cell.position.col_index >= 0
        and cell.position.col_index < cell.board.grid.cols
}

invariant BoardNameIsNonEmpty {
    for board in Boards:
        board.name != ""
}

invariant CellRowInBoardLibrary {
    for cell in Cells:
        cell.row != null implies cell.row.library = cell.board.library
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface BoardList {
    facing user: Library
    context library: Library

    provides:
        CreateBoardConfirmed(library, name, grid, show_labels)
        BoardOpened(board)
        BoardConfigured(board, name, grid, show_labels)
        DuplicateBoardRequested(board)
        DeleteBoardConfirmed(board)
        BoardPdfRequested(board, paper)

    @guidance
        -- Card grid: thumbnail of the grid, name, dimensions, relative date
        -- and a "..." menu (Abrir, Editar, Duplicar, PDF Carta, PDF
        -- Tabloide); Eliminar lives in the Editar modal. A "Crear nuevo
        -- tablero" card. Empty state: "Crea tu primer tablero de
        -- comunicación." Clicking a card opens the editor.
}

surface BoardEditor {
    facing user: Library
    context session: BoardSession

    exposes:
        session.board.name
        session.board.grid
        session.board.show_labels
        session.mode
        for cell in session.board.cells:
            cell.color
            cell.row

    provides:
        CellTapped(session, cell)
        UseModeRequested(session) when session.mode = edit
        EditModeRequested(session) when session.mode = use
        LabelsToggled(session.board)
        BoardResized(session.board, grid)
        ConvertAudioRequested(session.board)

    @guarantee AudioIsSharedViaRow
        -- Audio lives on the Row, never on the Cell: two cells linked to
        -- the same Row always play the same clip.

    @guidance
        -- Edit header: back, board name (read-only), gear (rows x cols),
        -- label toggle, iOS conversion when needed, and the pencil / eye
        -- mode toggle. Cells: Fitzgerald background, best artifact
        -- (structured SVG > raw SVG > bitmap), caption when show_labels,
        -- a small speaker badge when the Row has audio. Edit mode scrolls
        -- when needed; use mode fits the viewport.
}

surface CellEditor {
    facing user: Library
    context session: BoardSession where mode = edit

    exposes:
        session.selected_cell
        session.recording

    provides:
        CellColorSelected(cell, color)
        CellRowSelected(cell, row)
        CellRowCleared(cell)
        RecordAudioRequested(session, cell)
        RecordingStopped(session, cell, clip)

    @guidance
        -- Floating, draggable panel: Color (seven swatches, active one
        -- marked), Pictograma (autocomplete, thumbnail, clear), Audio
        -- (player plus "Reemplazar audio", or "Agregar audio"; hidden with
        -- no linked row), and the shared-audio note.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- Resolved: board PDF export shipped (Letter and Tabloid, landscape)
-- Resolved: boards always open in edit mode; mode is not persisted
-- Resolved: use mode is full screen, left with a control or Escape

open question "TTS fallback: when a Row has no audio in use mode, speak the utterance, pulse, or do nothing?"

open question "Empty-cell tap in use mode: any feedback?"

open question "Maximum grid size: custom dimensions have no upper bound beyond the 6x8 preset."

open question "Audio duration: no maximum recording length. Audio lives in localStorage row metadata, so long clips consume the origin quota."

open question "Board PDF failures are only written to the browser console; should they reach the activity log like other exports?"

open question "Board edits do not update the library's last-modified date (only the board count). Intended?"
