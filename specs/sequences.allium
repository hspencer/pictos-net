-- allium: 3
-- sequences.allium

-- Scope: Sequences — named, ordered series of pictogram references within a
--   Library — their creation, editing and two exports (printable PDF and
--   pictogram ZIP). Also covers the library content modes (pictogramas |
--   secuencias | tableros), the library-menu entries for them, and the
--   whole-library "Descargar pictogramas" ZIP.
-- Includes:
--   - Sequence and Step entities
--   - SequenceList and SequenceEditor (list and grid layouts)
--   - Autocomplete against the active Library's rows
--   - Creating a new Row from a step ("Generar")
--   - Sequence PDF: reuses the library printable engine with the sequence
--     name as title and a step-number badge per cell (pdf-export.allium)
--   - Sequence pictogram ZIP and library pictogram ZIP
-- Excludes:
--   - The printable PDF layout itself — see pdf-export.allium
--   - Library management — see library-manager.allium
--   - Pipeline internals — see visual-reasoning.allium
-- Storage (informative): sequences live in localStorage under
--   pictonet_lib_{id}_seqs, are saved on every change, and travel with
--   library download, backup, graph dump and templates (re-keyed to the
--   receiving library).
-- Dependencies:
--   - Row (visual-reasoning.allium), Library (library-manager.allium)

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- A pictogram record. Sequences reference Rows but do not own them.
external entity Row {
    library: Library
    utterance: String
    bitmap: String?
    raw_svg: String?
    structured_svg: String?
    has_content: Boolean            -- utterance, NLU or any media present
}

-- Defined in library-manager.allium.
external entity Library {
    name: String
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum StepState {
    blank           -- no utterance; a placeholder
    | pending       -- reserved: utterance typed, no Row linked. No current
                    --   code path produces it (see open questions)
    | complete      -- linked to a Row of the Library
}

-- The three content views of an open Library. Orthogonal to the list | grid
-- view mode of library-views.allium, which applies only to pictogramas.
enum LibraryContentMode {
    pictogramas
    | secuencias
    | tableros
}

enum SequenceLayout {
    list
    | grid
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- The content area of the open Library.
entity LibraryView {
    library: Library
    content_mode: LibraryContentMode
    sequence_layout: SequenceLayout     -- shared by all sequences; not persisted
}

entity Sequence {
    library: Library
    name: String
    steps: Step with sequence = this
    created_at: Timestamp
    modified_at: Timestamp

    complete_steps: steps where state = complete
    can_export: complete_steps.count > 0
}

entity Step {
    sequence: Sequence
    position: Integer               -- 1-based, contiguous
    utterance: String?
    row: Row?
    state: StepState
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    default_sequence_name: String = "Secuencia sin nombre"
    autocomplete_limit: Integer = 8
    zip_name_max_length: Integer = 30
    pdf_name_max_length: Integer = 40
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- === Content mode ===

rule OpenLibraryShowsPictogramas {
    when: LibraryOpened(view)
    ensures: view.content_mode = pictogramas

    @guidance
        -- Opening a library always lands on pictogramas.
}

rule SelectContentMode {
    when: ContentModeSelected(view, mode)
    ensures: view.content_mode = mode

    @guidance
        -- From the toolbar tabs, or "Mis secuencias" / "Mis tableros" in the
        -- library menu. Choosing secuencias shows SequenceList (any open
        -- sequence is closed); tableros shows BoardList (boards.allium).
}

-- === Sequence lifecycle ===

rule CreateSequence {
    when: CreateSequenceRequested(view)
    ensures:
        let sequence = Sequence.created(
            library: view.library,
            name: config.default_sequence_name,
            created_at: now,
            modified_at: now
        )
        SequenceOpened(sequence: sequence)

    @guidance
        -- No name prompt and no initial steps (changed: it used to prompt
        -- for a name and start with three blank steps). The editor opens at
        -- once; the user renames inline and adds steps.
}

rule RenameSequence {
    when: SequenceRenamed(sequence, name)
    requires: name != ""
    ensures: sequence.name = name
    ensures: sequence.modified_at = now

    @guidance
        -- Inline in the editor header (Enter commits, Escape or an empty
        -- name restores) or "Renombrar" in the card's "..." menu.
}

rule DeleteSequence {
    when: DeleteSequenceConfirmed(sequence)
    ensures: not exists sequence

    @guidance
        -- From the card's "..." menu. Rows referenced by its steps stay in
        -- the Library. The spec requires a destructive-action confirmation;
        -- the implementation currently deletes on the first click (see
        -- open questions).
}

-- === Step editing ===

rule AddStep {
    when: AddStepRequested(sequence)
    ensures: Step.created(
        sequence: sequence,
        position: sequence.steps.count + 1,
        utterance: null,
        row: null,
        state: blank
    )
    ensures: sequence.modified_at = now
}

rule LinkStepToRow {
    when: AutocompleteSuggestionSelected(step, row)
    requires: step.state = blank
    requires: row.library = step.sequence.library
    ensures: step.row = row
    ensures: step.utterance = row.utterance
    ensures: step.state = complete
    ensures: step.sequence.modified_at = now

    @guidance
        -- Suggestions: rows of the Library whose utterance contains the
        -- typed text (case-insensitive), at most autocomplete_limit, picked
        -- with the pointer. Never auto-linked on an exact match. Arrow-key
        -- navigation is not implemented; Enter means "Generar".
}

rule CreatePictogramForStep {
    when: GenerateStepRequested(step, text)
    requires: step.state = blank
    requires: text != ""
    ensures:
        let row = Row.created(library: step.sequence.library, utterance: text)
        step.row = row
        step.utterance = text
        step.state = complete
        CascadeRequested(row: row)

    @guidance
        -- "Generar" or Enter on the step field. The new Row joins the
        -- Library at once and the step is linked immediately (there is no
        -- in-progress pending state). The spec intends the cascade to start
        -- for the new row; the implementation currently creates the row
        -- idle and the user presses Play on it (see open questions). A
        -- linked step renders as the full row component with its step
        -- number and drag handle, so editing its utterance edits the Row
        -- itself; the earlier "edit unlinks the step" rule was never built.
}

rule DeleteStep {
    when: DeleteStepRequested(step)
    ensures: not exists step
    ensures:
        if step.row != null and not step.row.has_content:
            not exists step.row
    ensures: step.sequence.modified_at = now

    @guidance
        -- Remaining steps are renumbered. A linked Row with content stays
        -- in the Library; an empty one created for the step is removed.
}

rule ReorderStep {
    when: StepMoved(step, position)
    ensures: step.position = position
    ensures: step.sequence.modified_at = now

    @guidance
        -- Drag by the always-visible handle, in list or grid layout; all
        -- steps are renumbered.
}

-- === Exports ===

rule ExportSequencePdf {
    when: PrintSequenceRequested(sequence)
    requires: sequence.can_export
    ensures: SequencePdfDownloaded(sequence: sequence)

    @guidance
        -- Calls exportLibraryToPdf (pdf-export.allium) with the rows of the
        -- complete steps in position order (steps whose row no longer
        -- exists are skipped), titleOverride = sequence name, and a badge
        -- per cell with the step position. Caption = Row.utterance, never
        -- Step.utterance. Filename: "{sanitized name, max
        -- pdf_name_max_length}_{YYYY-MM-DD}.pdf". A failure is only logged
        -- to the browser console (see open questions).
}

rule ExportSequenceZip {
    when: SequenceZipRequested(sequence)
    requires: sequence.can_export
    ensures: SequenceZipDownloaded(sequence: sequence)

    @guidance
        -- One entry set per complete step, in position order, prefixed by
        -- its zero-padded ordinal among complete steps:
        -- "01-{utterance}.png" (bitmap) and "01-{utterance}.svg" (most
        -- downstream SVG: structured > raw). Filename:
        -- "{sanitize(sequence.name)}-pictogramas.zip".
}

rule DownloadLibraryPictogramsZip {
    when: LibraryPictogramsZipRequested(library)
    ensures: LibraryZipDownloaded(library: library)

    @guidance
        -- "Descargar pictogramas (N)" in the library menu, disabled when no
        -- row has media. Per row with media: "{sanitize(utterance)}.png"
        -- for the bitmap and "{sanitize(utterance)}.svg" for the most
        -- downstream SVG; rows without media are skipped. sanitize: strip
        -- accents, non-alphanumerics to "_", lowercase, at most
        -- zip_name_max_length characters, row id when empty. Filename:
        -- "{sanitize(library name)}-pictogramas.zip". No collision
        -- suffixes: rows whose names sanitise alike overwrite each other
        -- (see open questions).
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant SequenceNameIsNonEmpty {
    for sequence in Sequences:
        sequence.name != ""
}

invariant CompleteStepHasRow {
    for step in Steps:
        (step.state = complete implies step.row != null)
        and (step.state != complete implies step.row = null)
}

invariant BlankStepHasNoUtterance {
    for step in Steps:
        step.state = blank implies step.utterance = null
}

invariant StepRowBelongsToSequenceLibrary {
    for step in Steps:
        step.row != null implies step.row.library = step.sequence.library
}

invariant PositionsAreContiguous {
    for step in Steps:
        step.position >= 1 and step.position <= step.sequence.steps.count
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface LibraryContentToggle {
    facing user: LibraryView
    context view: LibraryView

    exposes:
        view.content_mode

    provides:
        ContentModeSelected(view, mode)

    @guidance
        -- Three text tabs at the left of the library toolbar: Pictogramas,
        -- Secuencias, Tableros; the active one darker and aria-pressed. The
        -- list | grid switcher sits at the right end and only in
        -- pictogramas.
}

surface LibraryMenu {
    facing user: LibraryView
    context view: LibraryView

    provides:
        ContentModeSelected(view, mode)
        LibraryPictogramsZipRequested(view.library)

    @guidance
        -- The open library's dropdown: Configurar librería, Mis secuencias,
        -- Mis tableros, the pictogram count, Importar frases, Importar
        -- librería (.json), Exportar librería (.json), Exportar frases
        -- (.txt), Descargar imprimibles (pdf-export.allium), Descargar
        -- pictogramas (N), then batch generation. The whole-library PDF
        -- action is labelled "Descargar imprimibles".
}

surface SequenceList {
    facing user: LibraryView
    context view: LibraryView where content_mode = secuencias

    provides:
        CreateSequenceRequested(view)
        SequenceRenamed(sequence, name)
        DeleteSequenceConfirmed(sequence)

    @guidance
        -- Card grid: preview of the first linked pictograms, name, "N
        -- pasos" with the complete count, relative date and a "..." menu
        -- (Abrir, Renombrar, Eliminar). A "Crear nueva secuencia" card.
        -- Empty state: a short "no sequences yet" line. Clicking a card
        -- opens the editor.
}

surface SequenceEditor {
    facing user: LibraryView
    context sequence: Sequence

    exposes:
        sequence.name
        sequence.can_export
        for step in sequence.steps:
            step.position
            step.state
            step.utterance

    provides:
        SequenceRenamed(sequence, name)
        AddStepRequested(sequence)
        AutocompleteSuggestionSelected(step, row)
        GenerateStepRequested(step, text)
        DeleteStepRequested(step)
        StepMoved(step, position)
        PrintSequenceRequested(sequence) when sequence.can_export
        SequenceZipRequested(sequence) when sequence.can_export

    @guidance
        -- Header: back to the list, inline-editable name, its own list |
        -- grid switcher, "Imprimir" and "Descargar" (disabled without
        -- complete steps), and a step count. List layout: blank steps show
        -- a drag handle, a text field with autocomplete, "Generar" and a
        -- delete button; linked steps show the full row component (step
        -- number, drag handle, pipeline controls). Grid layout mirrors
        -- PictogramGridCell (square picture, caption from Row.utterance on
        -- up to three lines, step number chip top-left) and is read and
        -- reorder only. "Agregar paso" below; with no complete steps a hint
        -- says to add pictograms before printing or downloading.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- Resolved: sequences are library-scoped; autocomplete and new rows use the active Library
-- Resolved: sequence PDF homologated with the library printable export
-- Resolved: "Descargar PDF" renamed to "Descargar imprimibles"
-- Superseded: a new sequence prompted for a name and started with three blank steps
-- Superseded: editing a complete step's utterance reset its link
-- Superseded: ZIP collision suffixes "_2", "_3" were specified but never built

open question "DeleteSequence has no confirmation in the implementation (SequenceList onDelete removes at once). Add the confirmation, or accept one-click deletion?"

open question "'Generar' creates the row idle; an unused handler with auto-cascade exists. Should Generar start the cascade, as the label implies?"

open question "StepState.pending is never produced. Drop it, or restore an in-progress state for generated steps?"

open question "Library pictogram ZIP: duplicate sanitised utterances overwrite each other. Add collision suffixes?"

open question "Maximum steps per sequence: none; long sequences produce many PDF pages."
