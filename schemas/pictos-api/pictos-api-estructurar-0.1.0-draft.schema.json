{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pictos.net/schemas/pictos-api/pictos-api-estructurar-0.1.0-draft.schema.json",
  "title": "PICTOS API v1 estructurar boundary 0.1.0-draft",
  "description": "DRAFT. Not served yet. Separate, optional fourth endpoint. Receives the produced artifact, the NLU and the accepted composition, and returns an mf-svg-schema SVG together with an explicit account of what could not be structured. Reconstructing semantic structure from a bitmap is an open research problem at pictos.net; this contract reports losses instead of pretending otherwise.",
  "x-status": "draft",
  "$defs": {
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "nlu",
        "composition"
      ],
      "properties": {
        "artifact": {
          "$ref": "https://pictos.net/schemas/pictos-api/pictos-api-producir-0.1.0-draft.schema.json#/$defs/Artifact"
        },
        "nlu": {
          "$ref": "https://pictos.net/schemas/pictonet-nlu-1.1.0.schema.json"
        },
        "composition": {
          "$ref": "https://pictos.net/schemas/pictogram-composition-0.1.0.schema.json"
        },
        "model": {
          "type": "string",
          "description": "A phase 4 (structuring) model from the pictos.net catalog."
        }
      }
    },
    "Loss": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "description"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "vectorization",
            "merge",
            "simplification",
            "unassigned_geometry",
            "missing_element",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "element_id": {
          "type": "string"
        }
      }
    },
    "OrphanMark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mark_id",
        "reason"
      ],
      "description": "A geometric mark that could not be assigned to any composition element.",
      "properties": {
        "mark_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "AmbiguousAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mark_id",
        "candidates",
        "chosen"
      ],
      "properties": {
        "mark_id": {
          "type": "string"
        },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "chosen": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "reconstruction",
        "artifact_sha256"
      ],
      "properties": {
        "source_kind": {
          "enum": [
            "bitmap",
            "svg"
          ]
        },
        "reconstruction": {
          "enum": [
            "vectorized_from_bitmap",
            "structured_from_provider_svg"
          ],
          "description": "vectorized_from_bitmap is experimental: geometry is traced, then grouped; the semantic grouping is a proposal, not a recovered fact."
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "composition_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "nlu_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "Output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "svg",
        "svg_schema",
        "losses",
        "orphan_marks",
        "ambiguous_assignments",
        "provenance"
      ],
      "properties": {
        "svg": {
          "type": "string",
          "contentMediaType": "image/svg+xml",
          "minLength": 1
        },
        "svg_schema": {
          "const": "https://pictos.net/schemas/metadata-2.0.0-draft.1.schema.json"
        },
        "losses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Loss"
          }
        },
        "orphan_marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OrphanMark"
          }
        },
        "ambiguous_assignments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AmbiguousAssignment"
          }
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      }
    },
    "Response": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://pictos.net/schemas/pictos-api/pictos-api-common-1.0.0.schema.json#/$defs/SuccessMeta"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "output"
      ],
      "properties": {
        "process": {
          "type": "object",
          "properties": {
            "name": {
              "const": "estructurar"
            }
          }
        },
        "output": {
          "$ref": "#/$defs/Output"
        }
      }
    }
  }
}
