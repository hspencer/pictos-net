{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pictos.net/schemas/pictos-api/pictos-api-componer-response-1.0.0.schema.json",
  "title": "PICTOS API v1 componer response 1.0.0",
  "description": "Success envelope. output is the accepted pictogram-composition-0.1.0 artifact with its deterministic root (pictograma or pictogram) built by pictos.net, never by the model. The provider-facing schema pictogram-composition-provider-0.1.0 stays internal.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://pictos.net/schemas/pictos-api/pictos-api-common-1.0.0.schema.json#/$defs/SuccessMeta"
    }
  ],
  "unevaluatedProperties": false,
  "required": [
    "output"
  ],
  "properties": {
    "process": {
      "type": "object",
      "properties": {
        "name": {
          "const": "componer"
        }
      }
    },
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "const": "https://pictos.net/schemas/pictogram-composition-0.1.0.schema.json"
        }
      }
    },
    "output": {
      "$ref": "https://pictos.net/schemas/pictogram-composition-0.1.0.schema.json"
    }
  }
}
