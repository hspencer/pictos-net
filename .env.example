# Local development environment variables
# Copy to .env and fill in real values. Never commit .env — it is git-ignored.
# For Netlify deployments, copy to .env-netlify (also git-ignored) and run:
#   netlify env:import .env-netlify

# ── AI API Keys (required) ─────────────────────────────────────────────────────
# PICTOS_ANTHROPIC_KEY is used by api-claude.js instead of ANTHROPIC_API_KEY to
# avoid Netlify CLI v24 overriding it with a Netlify AI Gateway JWT at dev time.
PICTOS_ANTHROPIC_KEY=sk-ant-api03-...
# Keep ANTHROPIC_API_KEY as fallback (used if PICTOS_ANTHROPIC_KEY is absent).
ANTHROPIC_API_KEY=sk-ant-api03-...
RECRAFT_API_KEY=re-...

# OpenAI: Phase 3 default (gpt-image-2.5-flare) and GPT-6 Luna for phases 1-2.
# Server only; never use a VITE_ prefix.
OPENAI_API_KEY=sk-...
# Optional priority alias when a local AI gateway overrides OPENAI_API_KEY:
# PICTOS_OPENAI_KEY=sk-...

# ── Vertex AI (Nano Banana 2 Lite in phase 3 + entity detection) ─────────────
# No API keys. Auth is a Google service account (role: Vertex AI User) whose
# JSON credential goes here AS A SINGLE LINE (the whole file, minified).
# The same credential works in local dev (netlify dev) and in Netlify deploys.
# Tokens are short-lived (~1 h) and signed per-request; nothing static to steal.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com",...}
# Optional overrides (project defaults to the service account's project_id):
# VERTEX_PROJECT_ID=my-project
# VERTEX_LOCATION=global

# ── GitHub token for pictogram sharing (optional) ─────────────────────────────
# Used only by share-pictogram, which no client flow calls today.
# Needs: repo:write on pictogram-collector
GITHUB_TOKEN=ghp_...

# ── Usage quota (optional, code default: 50) ──────────────────────────────────
# Maximum units per user per calendar day (UTC). Production 50, preview 100.
# Charged: every phase 3 image (OpenAI, Gemini, Recraft) = 1 unit, refunded once
# on failure; pipeline batch = 1 unit per row at create.
# Free: all Claude and OpenAI text calls, entity detection, API v1 = 0 units.
# The 'superuser' role bypasses the limit.
DAILY_LIMIT_PER_USER=50

# ── Usage report access (optional) ────────────────────────────────────────────
# api-usage-report accepts the Identity user whose email is ADMIN_EMAIL, or
# Authorization: Bearer <ADMIN_API_KEY> from scripts. Set both in Netlify too.
ADMIN_EMAIL=admin@example.org
ADMIN_API_KEY=replace-with-a-long-random-string

# ── Machine API v1, local only (optional) ─────────────────────────────────────
# Printed by: node scripts/service-credentials.mjs issue --local
# Accepted as service:dev only under netlify dev (NETLIFY_DEV=true).
# PICTOS_DEV_SERVICE_TOKEN=pk_...

# ── Batch generation (Vertex Batch API, dormant) ──────────────────────────────
# No catalog model supports Vertex batch today. GCS bucket for batch
# input/output. See docs/archivo/BATCH_GENERATION_DESIGN.md for the one-time bucket + IAM setup (service agent needs storage.objectAdmin).
VERTEX_BATCH_BUCKET=pictos-vertex-batch

# QuiverAI Arrow 2 (PRODUCIR, native SVG, experimental): https://platform.quiver.ai
# QUIVER_API_KEY=...

# Benchmark candidates (PRODUCIR), not used by the app
# FAL_KEY=...
